];

function updateFires() {
  for (let i = activeFires.length - 1; i >= 0; i--) {
    const f = activeFires[i];
    f.ttl--;
    if (f.ttl <= 0) {
      if (getTile(f.x, f.y) === "🔥") setTile(f.x, f.y, 0);
      activeFires.splice(i, 1);
    }
  }
  const available = 20 - activeFires.length;
  hudFireChargeVal.textContent = available + "/20";
  hudFireChargeVal.style.color = available === 0 ? "#ff2200" : available <= 5 ? "#ff8800" : "#ff6600";
}

function updateEnemies() {
  if (peacefulMode) return;
  const isNight = dayTime > 0.45 && dayTime < 0.95;
  const spawnRate = isNight ? 0.06 : 0.025;
  const maxEnemies = 20;
  if (enemies.length < maxEnemies && Math.random() < spawnRate && spawnPoints.length > 0 && rainbowSpawnSuppressTimer <= 0) {
    const s = spawnPoints[Math.floor(Math.random() * spawnPoints.length)];
    const pool = isNight ? ENEMY_TYPES : ENEMY_TYPES.filter(e => !e.night);
    const type = pool[Math.floor(Math.random() * pool.length)];
    enemies.push({ x: s.x, y: s.y, ...type, timer: 0, curHp: type.hp, skullIdx: Math.floor(Math.random() * 4) });
  }
  const enemyOccupied = new Set(enemies.map(e => k(e.x, e.y)));
  for (let i = enemies.length - 1; i >= 0; i--) {
    const e = enemies[i];
    if (player.hp <= 0) continue;

    // Fire tile — check before movement so fire isn't cleared first
    if (getTile(e.x, e.y) === "🔥" && e.curHp <= 2) {
      spawnParticles(e.x, e.y, "#ff6600", 8, 2);
      spawnParticles(e.x, e.y, "#ffcc00", 4, 1.5);
      xp += e.xp; score += e.xp * 10;
      setTile(e.x, e.y, 0);
      enemyOccupied.delete(k(e.x, e.y));
      enemies.splice(i, 1);
      checkLevelUp();
      continue;
    }

    const distToPlayer = Math.abs(e.x - player.x) + Math.abs(e.y - player.y);
    if (distToPlayer > 40) {
      enemyOccupied.delete(k(e.x, e.y));
      enemies.splice(i, 1);
      continue;
    }

    e.timer--;
    if (e.timer <= 0) {
      e.timer = e.speed;
      const dx = Math.sign(player.x - e.x), dy = Math.sign(player.y - e.y);
      let moved = false;
      for (const [ndx, ndy] of [[dx, dy],[dx, 0],[0, dy]]) {
        const nx = e.x + ndx, ny = e.y + ndy;
        const tile = getTile(nx, ny);
        if (tile === "iron" || tile === "door" || tile === "rock_lg" || tile === "rock_sub" || tile === "grass_rock" || tile === "house" || tile === "house_sub" || tile === "yellow_block" || tile === "castle" || tile === "castle_sub") continue;
        if (enemyOccupied.has(k(nx, ny))) continue;
        // Don't clear fire tiles — let enemies step onto them instead
        if (tile !== 0 && tile !== "lava" && tile !== "🔥" && tile !== "🌳" && tile !== "tree_sub" && tile !== "🌲" && tile !== "barren_sub" && tile !== "🌵" && tile !== "cactus_sub" && tile !== "flower_yellow" && tile !== "flower_pink" && tile !== "flower_blue") setTile(nx, ny, 0);
        enemyOccupied.delete(k(e.x, e.y));
        enemyOccupied.add(k(nx, ny));
        e.x = nx; e.y = ny; moved = true;
        if (corruptedHearts.length > 0) globalInvertedTiles.add(k(nx, ny));
        break;
      }
      if (e.x === player.x && e.y === player.y && player.invincible <= 0) {
        player.hp -= e.dmg;
        player.invincible = 20;
        shakeTimer = 10;
        playOuch();
      }
    }
  }
}

