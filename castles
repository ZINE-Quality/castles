function launchGame(peaceful = false) {
  peacefulMode = !!peaceful;
  try {
    const el = document.documentElement;
    const fn = el.requestFullscreen || el.webkitRequestFullscreen || el.msRequestFullscreen;
    if (fn) { const p = fn.call(el); if (p && p.catch) p.catch(() => {}); }
  } catch(_) {}
  if (tabletMode) {
    document.getElementById("controls").style.display = "none";
    document.getElementById("touchControls").style.display = "block";
    if (/iPhone|iPad|iPod/.test(navigator.userAgent)) {
      document.querySelector('meta[name="viewport"]').content =
        "width=device-width, initial-scale=0.6, maximum-scale=0.6, user-scalable=no";
      document.body.classList.add("ios-tablet");
    }
  }
  _deadPlayed = false;
  for (let i = 0; i < 15; i++) spawnStructure("room");
  for (let i = 0; i < 10; i++) spawnStructure("cross");
  for (let x = -12; x <= 12; x++)
    for (let y = -12; y <= 12; y++) getTile(x, y);
  placeFenceCompoundNearSpawn();
  const music = document.getElementById("bgMusic");
  music.volume = 0.3;
  music.play().catch(() => {});
  gameStarted = true;
  loop();
}

function startGame(peaceful = false) {
  showSkinScreen(peaceful);
}

document.getElementById("startBtn").onclick = () => startGame(false);
</script>
