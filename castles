(function initTouchControls() {
  const allBtns = document.querySelectorAll("#touchDpad button, #touchActions button");
  const moveKeys = new Set(["w","a","s","d"]);
  allBtns.forEach(btn => {
    const key = btn.dataset.key;
    function press(e) {
      e.preventDefault();
      keys[key] = true;
      btn.classList.add("pressed");
    }
    function release(e) {
      e.preventDefault();
      keys[key] = false;
      btn.classList.remove("pressed");
      if (moveKeys.has(key)) { player.moveHeld = false; player.moveDelay = 0; }
    }
    btn.addEventListener("touchstart", press, { passive: false });
    btn.addEventListener("touchend", release, { passive: false });
    btn.addEventListener("touchcancel", release, { passive: false });
    btn.addEventListener("mousedown", press);
    btn.addEventListener("mouseup", release);
    btn.addEventListener("mouseleave", release);
    btn.addEventListener("contextmenu", e => e.preventDefault());
  });
})();

function handleMovement() {
  if (player.hp <= 0) return;
  let dx = 0, dy = 0;
  if (keys["arrowleft"]  || keys["a"]) dx = -1;
  if (keys["arrowright"] || keys["d"]) dx =  1;
  if (keys["arrowup"]    || keys["w"]) dy = -1;
  if (keys["arrowdown"]  || keys["s"]) dy =  1;
  if (dx === 0 && dy === 0) { player.moveHeld = false; return; }
  const nx = player.x + dx, ny = player.y + dy;
  const nt = getTile(nx, ny);
  if (nt === "iron" || nt === "🪨" || nt === "rock_lg" || nt === "rock_sub" || nt === "grass_rock" || nt === "house" || nt === "house_sub" || nt === "castle" || nt === "castle_sub") return;
  if (nt === "yellow_block" && !hasKey) return;
  if (!player.moveHeld) {
    player.x += dx; player.y += dy;
    player.moveHeld = true; player.moveDelay = player.moveSpeed;
    stompGrass();
    if ((getTile(player.x, player.y) === "lava" || getTile(player.x, player.y) === "🔥") && player.invincible <= 0) {
      player.hp -= 10; player.invincible = 30; shakeTimer = 15; playOuch();
    }
    return;
  }
  player.moveDelay--;
  if (player.moveDelay <= 0) {
    player.x += dx; player.y += dy; player.moveDelay = 2;
    stompGrass();
    if ((getTile(player.x, player.y) === "lava" || getTile(player.x, player.y) === "🔥") && player.invincible <= 0) {
      player.hp -= 10; player.invincible = 30; shakeTimer = 15; playOuch();
    }
  }
}

const FLOWER_STOMP_COLORS = { flower_yellow: "#ffee44", flower_pink: "#ff88cc", flower_blue: "#66aaff" };
function stompGrass() {
  if (biome(player.x, player.y) !== "grasslands") return;
  if (!isGrassEdgeTile(player.x, player.y)) stompedGrassTiles.set(k(player.x, player.y), frameCount);
  const t = getTile(player.x, player.y);
  if (FLOWER_STOMP_COLORS[t]) {
    spawnParticles(player.x, player.y, FLOWER_STOMP_COLORS[t], 8, 1.5);
    setTile(player.x, player.y, 0);
  }
}

function handleActions() {
  if (player.hp <= 0) return;
  const x = player.x, y = player.y;
  if (keys["b"]) setTile(x, y, "🪨");
  if (keys["y"]) setTile(x, y, "🌳");
  if (keys["r"]) setTile(x, y, "🌵");
  if (keys["u"]) setTile(x, y, "🍄");
  if (keys["t"]) setTile(x, y, "iron");
  if (keys["g"]) setTile(x, y, "door");
  if (keys["f"]) {
    const isNight = dayTime > 0.45 && dayTime < 0.95;
    if (isNight) {
      showToast("🤖 OH NO!!! I can't get the fire started at night! 🤖", 7000, true);
      const fan = document.getElementById("fireAtNightSound");
      fan.currentTime = 0; fan.play().catch(() => {});
      keys["f"] = false;
    } else {
      if (activeFires.length < 20) {
        setTile(x, y, "🔥");
        activeFires.push({ x, y, ttl: 30 * 60 });
      }
      keys["f"] = false;
    }
  }
  if (keys["h"]) { setTile(x, y, "lava"); spawnPoints.push({ x, y }); }
  if (keys["z"] && !actionCooldown["bossSpawn"] && !peacefulMode) {
    const angle = Math.random() * Math.PI * 2;
    const dist = 12 + Math.floor(Math.random() * 6);
    const bX = player.x + Math.round(Math.cos(angle) * dist);
    const bY = player.y + Math.round(Math.sin(angle) * dist);
