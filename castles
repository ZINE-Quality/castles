function updateBait() {
  // Spawn bait pickup
  baitPickupSpawn--;
  if (baitPickupSpawn <= 0) {
    baitPickupSpawn = BAIT_SPAWN_INTERVAL;
    const angle = Math.random() * Math.PI * 2;
    const dist = 8 + Math.floor(Math.random() * 10);
    const px = player.x + Math.round(Math.cos(angle) * dist);
    const py = player.y + Math.round(Math.sin(angle) * dist);
    if (getTile(px, py) === 0) baitPickups.push({ x: px, y: py, ttl: 20 * 60 });
  }

  // Pickup collection
  for (let i = baitPickups.length - 1; i >= 0; i--) {
    const p = baitPickups[i];
    p.ttl--;
    if (p.ttl <= 0) { baitPickups.splice(i, 1); continue; }
    if (p.x === player.x && p.y === player.y) {
      baitPickups.splice(i, 1);
      activeBaits.push({ x: player.x, y: player.y, timer: BAIT_DURATION });
      spawnParticles(player.x, player.y, "#ffaa00", 10, 2);
      showToast("🪝 BAIT PLACED! Enemies attracted for 20s!");
    }
  }

  // Active baits
  for (let i = activeBaits.length - 1; i >= 0; i--) {
    const b = activeBaits[i];
    b.timer--;

    // Attract all enemies — move them toward bait each tick regardless of their own timer
    for (const e of enemies) {
      const dx = Math.sign(b.x - e.x);
      const dy = Math.sign(b.y - e.y);
      if (e.x !== b.x || e.y !== b.y) {
        e.x += dx;
        e.y += dy;
        e.timer = e.speed;
      }
    }

    // Attract bosses toward bait
    for (const boss of bosses) {
      boss.x += Math.sign(b.x - boss.x);
      boss.y += Math.sign(b.y - boss.y);
    }

    // Attract demons toward bait (teleport override — move toward bait instead)
    for (const d of demons) {
      const ddx = Math.sign(b.x - d.x);
      const ddy = Math.sign(b.y - d.y);
      if (d.x !== b.x || d.y !== b.y) {
        d.x += ddx;
        d.y += ddy;
      }
    }

    // Attract aliens toward bait
    for (const a of aliens) {
      if (a.x !== b.x || a.y !== b.y) {
        a.x += Math.sign(b.x - a.x);
        a.y += Math.sign(b.y - a.y);
        a.timer = a.speed;
      }
    }

    // Explode when timer runs out
    if (b.timer <= 0) {
      spawnParticles(b.x, b.y, "#ff6600", 30, 4);
      spawnParticles(b.x, b.y, "#ffff00", 20, 3);
      spawnParticles(b.x, b.y, "#ff0000", 15, 5);
      showToast("💥 BAIT EXPLODED!");
      for (let j = enemies.length - 1; j >= 0; j--) {
        const e = enemies[j];
        if (Math.abs(e.x - b.x) <= 3 && Math.abs(e.y - b.y) <= 3) {
          spawnParticles(e.x, e.y, "#ff4400", 6, 2);
          xp += e.xp; score += e.xp * 10;
          enemies.splice(j, 1);
          checkLevelUp();
        }
      }
      for (const boss of bosses) {
        if (Math.abs(boss.x - b.x) <= 3 && Math.abs(boss.y - b.y) <= 3) {
          boss.hp -= 20;
          spawnParticles(boss.x, boss.y, "#ff4400", 10, 2);
          spawnTextParticle(boss.x, boss.y - 1, "-20", "#ff4400");
        }
      }
      // Kill aliens in blast radius
      for (let j = aliens.length - 1; j >= 0; j--) {
        if (Math.abs(aliens[j].x - b.x) <= 3 && Math.abs(aliens[j].y - b.y) <= 3) {
          spawnParticles(aliens[j].x, aliens[j].y, "#aa44ff", 6, 2);
          xp += aliens[j].xp; score += aliens[j].xp * 10;
          aliens.splice(j, 1);
          checkLevelUp();
        }
      }
      activeBaits.splice(i, 1);
    }
  }
}

