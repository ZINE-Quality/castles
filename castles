function updateDayNight() {
  dayTime = (dayTime + 1 / DAY_CYCLE) % 1;
}

function getDayNightOverlay() {
  const t = dayTime;
  let darkness;
  if (t < 0.4)      darkness = 0;
  else if (t < 0.5) darkness = (t - 0.4) / 0.1 * 0.525;
  else if (t < 0.9) darkness = 0.525;
  else              darkness = (1 - t) / 0.1 * 0.525;
  return darkness;
}

function getDayLabel() {
  const t = dayTime;
  if (t < 0.4)      return { text: "DAY",   color: "#ffdd44" };
  if (t < 0.5)      return { text: "DUSK",  color: "#ff8844" };
  if (t < 0.9)      return { text: "NIGHT", color: "#8888ff" };
  return             { text: "DAWN",  color: "#ffaa44" };
}

function drawDayBar() {
  if (!_dayBarCtx) _dayBarCtx = hudDayBarCanvas.getContext("2d");
  const bx = _dayBarCtx;
  const W = hudDayBarCanvas.width, H = hudDayBarCanvas.height;
  bx.clearRect(0, 0, W, H);
  const trackY = H / 2, trackH = 6, trackR = 3;
  const trackX = 14, trackW = W - 28;
  bx.fillStyle = "#0a0a1a";
  bx.beginPath(); bx.roundRect(trackX, trackY - trackH/2, trackW, trackH, trackR); bx.fill();
  if (!_dayBarGrad) {
    _dayBarGrad = bx.createLinearGradient(trackX, 0, trackX + trackW, 0);
    _dayBarGrad.addColorStop(0, "#ffdd44"); _dayBarGrad.addColorStop(0.4, "#ffcc00");
    _dayBarGrad.addColorStop(0.45, "#ff6622"); _dayBarGrad.addColorStop(0.5, "#220066");
    _dayBarGrad.addColorStop(0.9, "#110044"); _dayBarGrad.addColorStop(1, "#ff9944");
  }
  bx.fillStyle = _dayBarGrad;
  bx.beginPath(); bx.roundRect(trackX, trackY - trackH/2, trackW, trackH, trackR); bx.fill();
  const indicX = trackX + dayTime * trackW;
  const isNight = dayTime > 0.45 && dayTime < 0.95;
  const glowColor = isNight ? "#8888ff" : "#ffdd44";
  bx.shadowColor = glowColor; bx.shadowBlur = 8;
  bx.beginPath(); bx.arc(indicX, trackY, 7, 0, Math.PI * 2);
  bx.fillStyle = isNight ? "#222255" : "#000"; bx.fill();
  bx.strokeStyle = glowColor; bx.lineWidth = 2; bx.stroke();
  bx.shadowBlur = 0;
  bx.font = "9px serif"; bx.textAlign = "center"; bx.textBaseline = "middle";
  bx.fillText(isNight ? "🌙" : "☀", indicX, trackY);
  for (const tick of [0.4, 0.5, 0.9]) {
    const tx = trackX + tick * trackW;
    bx.strokeStyle = "#ffffff22"; bx.lineWidth = 1;
    bx.beginPath(); bx.moveTo(tx, trackY - trackH/2 - 2); bx.lineTo(tx, trackY + trackH/2 + 2); bx.stroke();
  }
  bx.font = "10px serif"; bx.globalAlpha = 0.7;
  bx.fillText("☀", trackX - 8, trackY); bx.fillText("🌙", trackX + trackW + 8, trackY);
  bx.globalAlpha = 1;
}

function drawBossHealth(b) {
  const barW = TILE * 3, barH = 10;
  const px = b.x * TILE - camera.x + TILE / 2 - barW / 2;
  const py = (b.y - 1) * TILE - camera.y - 20;
  ctx.fillStyle = "#000"; ctx.fillRect(px - 1, py - 1, barW + 2, barH + 2);
  const pct = Math.max(0, b.hp / b.maxHp);
  ctx.fillStyle = pct > 0.5 ? "#00ff44" : pct > 0.25 ? "#ffaa00" : "#ff2200";
  ctx.fillRect(px, py, barW * pct, barH);
  ctx.strokeStyle = "#ffffff44"; ctx.lineWidth = 1; ctx.strokeRect(px, py, barW, barH);
  ctx.font = "10px 'Share Tech Mono'"; ctx.textAlign = "center"; ctx.fillStyle = "#fff";
  ctx.fillText(`BOSS ${Math.ceil(b.hp)}/${b.maxHp}`, px + barW / 2, py - 4);
}

function draw() {
  ctx.imageSmoothingEnabled = false;
  let shakeX = 0, shakeY = 0;
  if (shakeTimer > 0) {
    shakeX = (Math.random() - 0.5) * 8;
    shakeY = (Math.random() - 0.5) * 8;
    shakeTimer--;
  }
  ctx.fillStyle = "#000";
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  const playerScreenX = player.x * TILE - camera.x;
  const playerScreenY = player.y * TILE - camera.y;
  const centerX = canvas.width / 2, centerY = canvas.height / 2;
  if (playerScreenX < centerX - DEAD_ZONE) cameraTarget.x = player.x * TILE - (centerX - DEAD_ZONE);
  if (playerScreenX > centerX + DEAD_ZONE) cameraTarget.x = player.x * TILE - (centerX + DEAD_ZONE);
  if (playerScreenY < centerY - DEAD_ZONE) cameraTarget.y = player.y * TILE - (centerY - DEAD_ZONE);
  if (playerScreenY > centerY + DEAD_ZONE) cameraTarget.y = player.y * TILE - (centerY + DEAD_ZONE);
  camera.x += (cameraTarget.x - camera.x) * CAM_EASE + shakeX;
  camera.y += (cameraTarget.y - camera.y) * CAM_EASE + shakeY;
  // Snap to whole pixels — sub-pixel camera positions leave hairline gaps between adjacent
  // tile images (imageSmoothingEnabled is off), which show up as a distracting grid pattern.
  camera.x = Math.round(camera.x);
  camera.y = Math.round(camera.y);

  const sx = Math.floor(camera.x / TILE) - 1, sy = Math.floor(camera.y / TILE) - 1;
  const ex = sx + Math.ceil(canvas.width / TILE) + 2, ey = sy + Math.ceil(canvas.height / TILE) + 2;
  const darkness = getDayNightOverlay();

  ctx.strokeStyle = darkness > 0.5 ? "#0a1a0a" : "#111"; ctx.lineWidth = 0.5;
  for (let gx = sx; gx < ex; gx++) {
    const px = gx * TILE - camera.x;
    ctx.beginPath(); ctx.moveTo(px, 0); ctx.lineTo(px, canvas.height); ctx.stroke();
  }
  for (let gy = sy; gy < ey; gy++) {
    const py = gy * TILE - camera.y;
    ctx.beginPath(); ctx.moveTo(0, py); ctx.lineTo(canvas.width, py); ctx.stroke();
  }

  ctx.imageSmoothingEnabled = false;
  ctx.font = TILE + "px serif"; ctx.textAlign = "center"; ctx.textBaseline = "middle";
  const dirtReady = dirtImg.complete && dirtImg.naturalWidth > 0;
  const grassReady = grassImg.complete && grassImg.naturalWidth > 0;
  const grassStompReady = grassStompImg.complete && grassStompImg.naturalWidth > 0;
  const grassEdgeReady = grassEdgeImg.complete && grassEdgeImg.naturalWidth > 0;
  tryInitGrassRegrowData();
  const rockLgAnchors = [], treeLgAnchors = [], barrenLgAnchors = [], cactusLgAnchors = [], fireTiles = [], visibleFlowers = [], houseAnchors = [], castleAnchors = [];
  for (let y = sy; y < ey; y++) {
    for (let x = sx; x < ex; x++) {
      const t = getTile(x, y);
      const px = x * TILE - camera.x + TILE / 2, py = y * TILE - camera.y + TILE / 2;
      if (biome(x, y) === "grasslands") {
        const gpx = x * TILE - camera.x, gpy = y * TILE - camera.y;
        const gKey = k(x, y);
        const stompedAt = stompedGrassTiles.get(gKey);
        if (stompedAt !== undefined) {
          const regrowProgress = Math.min(1, (frameCount - stompedAt) / GRASS_REGROW_DURATION);
          if (regrowProgress >= 1) {
            stompedGrassTiles.delete(gKey);
            regrowBlendCache.delete(gKey);
            if (grassReady) ctx.drawImage(grassImg, gpx, gpy, TILE, TILE);
          } else {
            const blendCanvas = getRegrowingTileCanvas(gKey, regrowProgress);
            if (blendCanvas) ctx.drawImage(blendCanvas, gpx, gpy, TILE, TILE);
            else if (grassStompReady) ctx.drawImage(grassStompImg, gpx, gpy, TILE, TILE);
          }
        } else if (isGrassEdgeTile(x, y) && grassEdgeReady) {
          ctx.drawImage(grassEdgeImg, gpx, gpy, TILE, TILE);
        } else if (grassReady) {
          ctx.drawImage(grassImg, gpx, gpy, TILE, TILE);
        }
      } else if (dirtReady) {
        ctx.drawImage(dirtImg, x * TILE - camera.x, y * TILE - camera.y, TILE, TILE);
      }
      if (t === "lava") {
        const flicker = 0.8 + 0.2 * Math.sin(frameCount * 0.1 + x + y);
        ctx.fillStyle = `rgba(255,${Math.floor(60 * flicker)},0,0.92)`;
        ctx.fillRect(x * TILE - camera.x, y * TILE - camera.y, TILE, TILE);
      } else if (t === "iron") {
        ctx.fillStyle = "#334"; ctx.fillRect(x * TILE - camera.x, y * TILE - camera.y, TILE, TILE);
        ctx.strokeStyle = "#556"; ctx.lineWidth = 1;
        ctx.strokeRect(x * TILE - camera.x + 2, y * TILE - camera.y + 2, TILE - 4, TILE - 4);
      } else if (t === "yellow_block") {
        const ybx = x * TILE - camera.x, yby = y * TILE - camera.y;
        if (hasKey) {
          const pulse = 0.75 + 0.25 * Math.sin(frameCount * 0.1 + x + y);
          ctx.globalAlpha = pulse;
          ctx.shadowColor = "#ffee00"; ctx.shadowBlur = 10;
        }
        ctx.fillStyle = "#ffd700"; ctx.fillRect(ybx, yby, TILE, TILE);
        ctx.strokeStyle = "#7a5a00"; ctx.lineWidth = 2;
        ctx.strokeRect(ybx + 2, yby + 2, TILE - 4, TILE - 4);
        ctx.shadowBlur = 0; ctx.globalAlpha = 1;
      } else if (t === "door") {
        ctx.fillStyle = "#5a3010"; ctx.fillRect(x * TILE - camera.x, y * TILE - camera.y, TILE, TILE);
        ctx.fillStyle = "#7a4820";
        const bx2 = x * TILE - camera.x, by2 = y * TILE - camera.y;
        ctx.fillRect(bx2 + 4, by2 + 2, (TILE-8)/2 - 1, TILE - 4);
        ctx.fillRect(bx2 + 4 + (TILE-8)/2 + 2, by2 + 2, (TILE-8)/2 - 1, TILE - 4);
        ctx.fillStyle = "#ffd700";
        ctx.beginPath(); ctx.arc(bx2 + TILE * 0.65, by2 + TILE * 0.55, 2.5, 0, Math.PI * 2); ctx.fill();
        ctx.strokeStyle = "#3a1a00"; ctx.lineWidth = 2;
        ctx.strokeRect(bx2 + 2, by2 + 2, TILE - 4, TILE - 4);
      } else if (t === "🪨") {
        const rImg = rockImgs[2];
        if (rImg.complete && rImg.naturalWidth > 0) ctx.drawImage(rImg, x * TILE - camera.x, y * TILE - camera.y, TILE, TILE);
        else ctx.fillText(t, px, py);
      } else if (t === "rock_lg") {
        rockLgAnchors.push({x, y});
      } else if (t === "rock_sub") {
        // dirt already drawn; 4×4 image rendered in post-pass from anchor
      } else if (t === "🌳") {
        treeLgAnchors.push({x, y});
      } else if (t === "tree_sub") {
        // dirt already drawn; 4×4 image rendered in post-pass from anchor
      } else if (t === "🌲") {
        barrenLgAnchors.push({x, y});
      } else if (t === "barren_sub") {
        // dirt already drawn; 4×4 image rendered in post-pass from anchor
      } else if (t === "🌵") {
        cactusLgAnchors.push({x, y});
      } else if (t === "cactus_sub") {
        // dirt already drawn; 4×4 image rendered in post-pass from anchor
      } else if (t === "🍄") {
        const mImg = mushroomImgs[((x * 7 + y * 13) >>> 0) % 7];
        if (mImg.complete && mImg.naturalWidth > 0) ctx.drawImage(mImg, x * TILE - camera.x, y * TILE - camera.y, TILE, TILE);
        else ctx.fillText(t, px, py);
      } else if (t === "🔥") {
        fireTiles.push({x, y});
      } else if (t === "grass_rock") {
        const rImg = rockImgs[((x * 11 + y * 17) >>> 0) % 3];
        if (rImg.complete && rImg.naturalWidth > 0) ctx.drawImage(rImg, x * TILE - camera.x, y * TILE - camera.y, TILE, TILE);
        else ctx.fillText("🪨", px, py);
      } else if (t === "flower_yellow" || t === "flower_pink" || t === "flower_blue") {
        visibleFlowers.push({x, y, type: t.slice(7)});
      } else if (t === "house") {
        houseAnchors.push({x, y});
      } else if (t === "house_sub") {
        // grass already drawn; 8×8 image rendered in post-pass from anchor
      } else if (t === "castle") {
        castleAnchors.push({x, y});
      } else if (t === "castle_sub") {
        // ground already drawn; 12×12 image rendered in post-pass from anchor
      } else if (typeof t === "string") {
        ctx.fillText(t, px, py);
      }
    }
  }

  // Catch anchors just off the left/top viewport edge (bleed in up to 3 tiles)
  for (let y = sy - 3; y < sy; y++)
    for (let x = sx - 3; x < ex; x++) {
      const t = getTile(x, y);
      if (t === "rock_lg") rockLgAnchors.push({x, y});
      if (t === "🌳") treeLgAnchors.push({x, y});
      if (t === "🌲") barrenLgAnchors.push({x, y});
      if (t === "🌵") cactusLgAnchors.push({x, y});
    }
  for (let y = sy; y < ey; y++)
    for (let x = sx - 3; x < sx; x++) {
      const t = getTile(x, y);
      if (t === "rock_lg") rockLgAnchors.push({x, y});
      if (t === "🌳") treeLgAnchors.push({x, y});
      if (t === "🌲") barrenLgAnchors.push({x, y});
      if (t === "🌵") cactusLgAnchors.push({x, y});
    }
  // Catch house anchors just off the left/top viewport edge (bleed in up to 7 tiles — it's 8x8)
  for (let y = sy - 7; y < sy; y++)
    for (let x = sx - 7; x < ex; x++) {
      if (getTile(x, y) === "house") houseAnchors.push({x, y});
    }
  for (let y = sy; y < ey; y++)
    for (let x = sx - 7; x < sx; x++) {
      if (getTile(x, y) === "house") houseAnchors.push({x, y});
    }
  // Draw the 8×8 house above all terrain — solid, blocks movement like a rock
  for (const {x, y} of houseAnchors) {
    if (houseImg.complete && houseImg.naturalWidth > 0)
      ctx.drawImage(houseImg, x * TILE - camera.x, y * TILE - camera.y, TILE * HOUSE_SIZE, TILE * HOUSE_SIZE);
  }

  // Catch castle anchors just off the left/top viewport edge (bleed in up to 11 tiles — it's 12x12)
  for (let y = sy - 11; y < sy; y++)
    for (let x = sx - 11; x < ex; x++) {
      if (getTile(x, y) === "castle") castleAnchors.push({x, y});
    }
  for (let y = sy; y < ey; y++)
    for (let x = sx - 11; x < sx; x++) {
      if (getTile(x, y) === "castle") castleAnchors.push({x, y});
    }
  // Draw the 12×12 castle above all terrain — solid, blocks movement like a rock
  for (const {x, y} of castleAnchors) {
    if (castleImg.complete && castleImg.naturalWidth > 0)
      ctx.drawImage(castleImg, x * TILE - camera.x, y * TILE - camera.y, TILE * CASTLE_SIZE, TILE * CASTLE_SIZE);
  }

  // Draw 4×4 rock boulders above all terrain
  for (const {x, y} of rockLgAnchors) {
    const rImg = rockImgs[((x * 11 + y * 17) >>> 0) % 3];
    if (rImg.complete && rImg.naturalWidth > 0)
      ctx.drawImage(rImg, x * TILE - camera.x, y * TILE - camera.y, TILE * 4, TILE * 4);
  }
  // Draw 4×4 trees above all terrain
  for (const {x, y} of treeLgAnchors) {
    const tImg = treeImgs[((x * 5 + y * 19) >>> 0) % 2];
    if (tImg.complete && tImg.naturalWidth > 0)
      ctx.drawImage(tImg, x * TILE - camera.x, y * TILE - camera.y, TILE * 4, TILE * 4);
  }
  // Draw 4×4 barren trees above all terrain
  for (const {x, y} of barrenLgAnchors) {
    const bImg = barrenImgs[((x * 3 + y * 23) >>> 0) % 2];
    if (bImg.complete && bImg.naturalWidth > 0)
      ctx.drawImage(bImg, x * TILE - camera.x, y * TILE - camera.y, TILE * 4, TILE * 4);
  }
  // Draw 4×4 cacti above all terrain
  for (const {x, y} of cactusLgAnchors) {
    const cImg = cactusImgs[((x * 7 + y * 31) >>> 0) % 2];
    if (cImg.complete && cImg.naturalWidth > 0)
      ctx.drawImage(cImg, x * TILE - camera.x, y * TILE - camera.y, TILE * 4, TILE * 4);
  }

  // Corrupted tile inversions — every tile a Corrupted Heart's minions (or corrupted regular
  // enemies) cross gets its colors inverted for as long as a heart lives; cleared once the
  // last heart is defeated.
  if (corruptedHearts.length > 0) {
    ctx.globalCompositeOperation = "difference";
    ctx.fillStyle = "#ffffff";
    for (const h of corruptedHearts) {
      for (const key of h.invertedTiles) {
        const [tx, ty] = key.split(",").map(Number);
        if (tx < sx - 1 || tx > ex || ty < sy - 1 || ty > ey) continue;
        ctx.fillRect(tx * TILE - camera.x, ty * TILE - camera.y, TILE, TILE);
      }
    }
    for (const key of globalInvertedTiles) {
      const [tx, ty] = key.split(",").map(Number);
      if (tx < sx - 1 || tx > ex || ty < sy - 1 || ty > ey) continue;
      ctx.fillRect(tx * TILE - camera.x, ty * TILE - camera.y, TILE, TILE);
    }
    ctx.globalCompositeOperation = "source-over";
  }

  // Position fire GIF pool elements over visible fire tiles
  fireGifPool.forEach((el, i) => {
    if (i < fireTiles.length) {
      const {x, y} = fireTiles[i];
      el.style.display = 'block';
      el.style.left  = Math.round(x * TILE - camera.x) + 'px';
      el.style.top   = Math.round(y * TILE - camera.y) + 'px';
      el.style.width  = TILE + 'px';
      el.style.height = TILE + 'px';
    } else {
      el.style.display = 'none';
    }
  });

  // Position flower GIF pool over visible flowers — the 7-frame animation plays only while
  // the player is within 8 tiles; otherwise a frozen first-frame snapshot is shown instead.
  flowerGifPool.forEach((el, i) => {
    if (i < visibleFlowers.length) {
      const f = visibleFlowers[i];
      const near = (Math.abs(f.x - player.x) + Math.abs(f.y - player.y)) <= 8;
      const mode = near ? "near" : "far";
      const key = f.x + "," + f.y + ":" + f.type;
      if (el.dataset.key !== key || el.dataset.mode !== mode) {
        el.dataset.key = key;
        el.dataset.mode = mode;
        el.src = near ? flowerGifSrcs[f.type] : (flowerStaticSrcs[f.type] || flowerGifSrcs[f.type]);
      }
      el.style.display = 'block';
      el.style.left = Math.round(f.x * TILE - camera.x) + 'px';
      el.style.top = Math.round(f.y * TILE - camera.y) + 'px';
      el.style.width = TILE + 'px';
      el.style.height = TILE + 'px';
    } else {
      el.style.display = 'none';
    }
  });

  // Compass arrow — points at the axer until the key is earned, then switches to point at
  // the new key-gated fence instead.
  if (showAxerArrow) {
    let targetX = null, targetY = null;
    if (keyFence) {
      targetX = keyFence.x + keyFence.size / 2;
      targetY = keyFence.y + keyFence.size / 2;
    } else if (fenceCompounds.length > 0) {
      targetX = fenceCompounds[0].axer.x;
      targetY = fenceCompounds[0].axer.y;
    }
    if (targetX !== null) {
      const adx = targetX - player.x, ady = targetY - player.y;
      const angleDeg = Math.atan2(ady, adx) * 180 / Math.PI;
      const arrowEl = document.getElementById("axerArrow");
      arrowEl.style.display = 'block';
      arrowEl.style.transform = `rotate(${angleDeg}deg)`;
    }
  }

  // Rage pickups
  for (const rp of ragePickups) {
    const rpx = rp.x * TILE - camera.x, rpy = rp.y * TILE - camera.y;
    const expiring = rp.ttl < 3 * 60;
    const pulse = expiring ? (Math.floor(frameCount / 8) % 2 === 0 ? 0.9 : 0.1) : 0.7 + 0.3 * Math.sin(frameCount * 0.12);
    ctx.globalAlpha = pulse;
    if (!expiring) { ctx.shadowColor = "#ff4400"; ctx.shadowBlur = 10; }
    if (rageIconImg.complete && rageIconImg.naturalWidth > 0) ctx.drawImage(rageIconImg, rpx + 2, rpy + 2, TILE - 4, TILE - 4);
    else { ctx.font = (TILE * 0.8) + "px serif"; ctx.fillText("😡", rpx + TILE/2, rpy + TILE/2); }
    ctx.shadowBlur = 0; ctx.globalAlpha = 1;
  }

  // Purple pickups
  for (const pp of purplePickups) {
    const ppx = pp.x * TILE - camera.x, ppy = pp.y * TILE - camera.y;
    const expiring = pp.ttl < 3 * 60;
    const pulse = expiring ? (Math.floor(frameCount / 8) % 2 === 0 ? 0.9 : 0.1) : 0.7 + 0.3 * Math.sin(frameCount * 0.15);
    ctx.globalAlpha = pulse;
    if (!expiring) { ctx.shadowColor = "#cc44ff"; ctx.shadowBlur = 10; }
    if (purpleIconImg.complete && purpleIconImg.naturalWidth > 0) ctx.drawImage(purpleIconImg, ppx + 2, ppy + 2, TILE - 4, TILE - 4);
    else { ctx.font = (TILE * 0.8) + "px serif"; ctx.fillText("⚡", ppx + TILE/2, ppy + TILE/2); }
    ctx.shadowBlur = 0; ctx.globalAlpha = 1;
  }

  // Wrench pickups
  for (const wp of wrenchPickups) {
    const wpx = wp.x * TILE - camera.x, wpy = wp.y * TILE - camera.y;
    const expiring = wp.ttl < 3 * 60;
    const pulse = expiring ? (Math.floor(frameCount / 8) % 2 === 0 ? 0.9 : 0.1) : 0.7 + 0.3 * Math.sin(frameCount * 0.13);
    ctx.globalAlpha = pulse;
    if (!expiring) { ctx.shadowColor = "#44ff88"; ctx.shadowBlur = 10; }
    if (wrenchIconImg.complete && wrenchIconImg.naturalWidth > 0) ctx.drawImage(wrenchIconImg, wpx + 2, wpy + 2, TILE - 4, TILE - 4);
    else { ctx.font = (TILE * 0.8) + "px serif"; ctx.fillText("🔧", wpx + TILE/2, wpy + TILE/2); }
    ctx.shadowBlur = 0; ctx.globalAlpha = 1;
  }

  // Bait pickups
  for (const bp of baitPickups) {
    const bpx = bp.x * TILE - camera.x, bpy = bp.y * TILE - camera.y;
    const expiring = bp.ttl < 3 * 60;
    const pulse = expiring ? (Math.floor(frameCount / 8) % 2 === 0 ? 0.9 : 0.1) : 0.7 + 0.3 * Math.sin(frameCount * 0.13);
    ctx.globalAlpha = pulse;
    if (!expiring) { ctx.shadowColor = "#00ff44"; ctx.shadowBlur = 10; }
    if (baitIconImg.complete && baitIconImg.naturalWidth > 0) ctx.drawImage(baitIconImg, bpx + 2, bpy + 2, TILE - 4, TILE - 4);
    else { ctx.font = (TILE * 0.8) + "px serif"; ctx.textAlign = "center"; ctx.textBaseline = "middle"; ctx.fillText("🪝", bpx + TILE/2, bpy + TILE/2); }
    ctx.shadowBlur = 0; ctx.globalAlpha = 1;
  }

  // Active baits on board
  for (const ab of activeBaits) {
    const baitSize = TILE * 5;
    const abx = ab.x * TILE + TILE/2 - camera.x - baitSize/2;
    const aby = ab.y * TILE + TILE/2 - camera.y - baitSize/2;
    const flicker = 0.6 + 0.4 * Math.sin(frameCount * 0.15);
    const warning = ab.timer < 3 * 60;
    ctx.globalAlpha = warning ? (Math.floor(frameCount / 4) % 2 === 0 ? 1 : 0.2) : flicker;
    if (!warning) { ctx.shadowColor = "#00ff44"; ctx.shadowBlur = 12; }
    if (baitImg.complete && baitImg.naturalWidth > 0) ctx.drawImage(baitImg, abx, aby, baitSize, baitSize);
    else { ctx.font = (TILE * 3) + "px serif"; ctx.textAlign = "center"; ctx.textBaseline = "middle"; ctx.fillText("🪝", ab.x * TILE + TILE/2 - camera.x, ab.y * TILE + TILE/2 - camera.y); }
    ctx.shadowBlur = 0; ctx.globalAlpha = 1;
    // Timer bar
    const barW = TILE * 2;
    const barX = ab.x * TILE + TILE/2 - camera.x - barW/2;
    const barY = ab.y * TILE - camera.y - baitSize/2 - 8;
    const pct = ab.timer / BAIT_DURATION;
    ctx.fillStyle = "#000"; ctx.fillRect(barX, barY, barW, 4);
    ctx.fillStyle = pct > 0.5 ? "#ffaa00" : pct > 0.25 ? "#ff6600" : "#ff0000";
    ctx.fillRect(barX, barY, barW * pct, 4);
  }

  // Rainbow pickups
  for (const rp of rainbowPickups) {
    const rpx = rp.x * TILE - camera.x, rpy = rp.y * TILE - camera.y;
    const expiring = rp.ttl < 3 * 60;
    const pulse = expiring ? (Math.floor(frameCount / 8) % 2 === 0 ? 0.9 : 0.1) : 0.7 + 0.3 * Math.sin(frameCount * 0.14);
    ctx.globalAlpha = pulse;
    if (!expiring) { ctx.shadowColor = `hsl(${(frameCount * 4) % 360},100%,60%)`; ctx.shadowBlur = 12; }
    if (rainbowIconImg.complete && rainbowIconImg.naturalWidth > 0) ctx.drawImage(rainbowIconImg, rpx + 2, rpy + 2, TILE - 4, TILE - 4);
    else { ctx.font = (TILE * 0.8) + "px serif"; ctx.textAlign = "center"; ctx.textBaseline = "middle"; ctx.fillText("🌈", rpx + TILE/2, rpy + TILE/2); }
    ctx.shadowBlur = 0; ctx.globalAlpha = 1;
  }

  // Mystery pickups
  for (const mp of mysteryPickups) {
    const mpx = mp.x * TILE - camera.x, mpy = mp.y * TILE - camera.y;
    const expiring = mp.ttl < 3 * 60;
    const pulse = expiring ? (Math.floor(frameCount / 8) % 2 === 0 ? 0.9 : 0.1) : 0.7 + 0.3 * Math.sin(frameCount * 0.14);
    ctx.globalAlpha = pulse;
    if (!expiring) { ctx.shadowColor = `hsl(${(frameCount * 6) % 360},100%,60%)`; ctx.shadowBlur = 12; }
    const mImg = mysteryIconImgs[mp.iconIdx];
    if (mImg.complete && mImg.naturalWidth > 0) ctx.drawImage(mImg, mpx + 2, mpy + 2, TILE - 4, TILE - 4);
    else { ctx.font = (TILE * 0.8) + "px serif"; ctx.textAlign = "center"; ctx.textBaseline = "middle"; ctx.fillText("🎲", mpx + TILE/2, mpy + TILE/2); }
    ctx.shadowBlur = 0; ctx.globalAlpha = 1;
  }

  // 2x Clone pickups
  for (const cp of clone2xPickups) {
    const cpx = cp.x * TILE - camera.x, cpy = cp.y * TILE - camera.y;
    const expiring = cp.ttl < 3 * 60;
    const pulse = expiring ? (Math.floor(frameCount / 8) % 2 === 0 ? 0.9 : 0.1) : 0.7 + 0.3 * Math.sin(frameCount * 0.13);
    ctx.globalAlpha = pulse;
    if (!expiring) { ctx.shadowColor = "#00ccff"; ctx.shadowBlur = 10; }
    if (clone2xIconImg.complete && clone2xIconImg.naturalWidth > 0) ctx.drawImage(clone2xIconImg, cpx + 2, cpy + 2, TILE - 4, TILE - 4);
    else { ctx.font = (TILE * 0.8) + "px serif"; ctx.textAlign = "center"; ctx.textBaseline = "middle"; ctx.fillText("2X", cpx + TILE/2, cpy + TILE/2); }
    ctx.shadowBlur = 0; ctx.globalAlpha = 1;
  }

  // Alien spawners
  for (const s of alienSpawners) {
    const spx = s.x * TILE - camera.x, spy = s.y * TILE - camera.y;
    if (s.defeated) {
      const blink = Math.floor(frameCount / 8) % 2 === 0;
      ctx.globalAlpha = blink ? 0.9 : 0.4;
      if (alienSpawnerImg.complete && alienSpawnerImg.naturalWidth > 0)
        ctx.drawImage(alienSpawnerImg, spx, spy, TILE * 2, TILE * 2);
      ctx.globalAlpha = blink ? 0.35 : 0.15;
      ctx.fillStyle = "#ff2200";
      ctx.fillRect(spx, spy, TILE * 2, TILE * 2);
    } else {
      const pulse = 0.7 + 0.3 * Math.sin(frameCount * 0.1);
      ctx.shadowColor = "#aa44ff"; ctx.shadowBlur = 8;
      ctx.globalAlpha = pulse;
      if (alienSpawnerImg.complete && alienSpawnerImg.naturalWidth > 0)
        ctx.drawImage(alienSpawnerImg, spx, spy, TILE * 2, TILE * 2);
      else {
        ctx.font = (TILE * 1.5) + "px serif";
        ctx.textAlign = "center"; ctx.textBaseline = "middle";
        ctx.fillText("🛸", spx + TILE, spy + TILE);
      }
      // Health bar
      const barW = TILE * 2, barH = 4;
      const barX = spx, barY = spy - barH - 2;
      ctx.globalAlpha = 1; ctx.shadowBlur = 0;
      ctx.fillStyle = "#330000";
      ctx.fillRect(barX, barY, barW, barH);
      ctx.fillStyle = s.hp / s.maxHp > 0.5 ? "#44ff44" : s.hp / s.maxHp > 0.25 ? "#ffaa00" : "#ff2200";
      ctx.fillRect(barX, barY, barW * (s.hp / s.maxHp), barH);
    }
    ctx.shadowBlur = 0; ctx.globalAlpha = 1;
  }

  // Aliens
  for (const a of aliens) {
    const aSize = TILE * 3;
    const apx = a.x * TILE + TILE/2 - camera.x - aSize/2;
    const apy = a.y * TILE + TILE/2 - camera.y - aSize/2;
    const aImg = a.type === 1 ? alien1Img : alien2Img;
    if (aImg.complete && aImg.naturalWidth > 0) {
      ctx.drawImage(aImg, apx, apy, aSize, aSize);
    } else {
      ctx.font = aSize + "px serif";
      ctx.textAlign = "center"; ctx.textBaseline = "middle";
      ctx.fillText("👽", a.x * TILE + TILE/2 - camera.x, a.y * TILE + TILE/2 - camera.y);
    }
  }

  // Axers — wander harmlessly inside their fenced grasslands compound
  for (const fc of fenceCompounds) {
    const a = fc.axer;
    const aSize = TILE * 2.85; // 3x — wanderBounds is inset to keep this from bleeding into the fence/house
    const axpx = a.x * TILE + TILE/2 - camera.x - aSize/2;
    const axpy = a.y * TILE + TILE/2 - camera.y - aSize/2;
    if (axerImg.complete && axerImg.naturalWidth > 0) {
      ctx.drawImage(axerImg, axpx, axpy, aSize, aSize);
    } else {
      ctx.font = aSize + "px serif";
      ctx.textAlign = "center"; ctx.textBaseline = "middle";
      ctx.fillText("🪓", a.x * TILE + TILE/2 - camera.x, a.y * TILE + TILE/2 - camera.y);
    }
  }

  // Corrupted minions — spawned by the Corrupted Heart, die in one hit.
  // Each is the corrupted twin of a boss, rendered at that same boss's size.
  for (const m of corruptedMinions) {
    const isDragonType = m.type === 4;
    const mW = isDragonType ? TILE * 9 : TILE * 3;
    const mH = isDragonType ? TILE * 6 : TILE * 3;
    const mpx = m.x * TILE + TILE/2 - camera.x - mW/2;
    const mpy = m.y * TILE + TILE/2 - camera.y - mH/2;
    const mImg = corruptedMinionImgs[m.type];
    ctx.shadowColor = "#ff0066"; ctx.shadowBlur = 6;
    if (mImg.complete && mImg.naturalWidth > 0) {
      ctx.drawImage(mImg, mpx, mpy, mW, mH);
    } else {
      ctx.font = mW + "px serif";
      ctx.textAlign = "center"; ctx.textBaseline = "middle";
      ctx.fillText("💢", m.x * TILE + TILE/2 - camera.x, m.y * TILE + TILE/2 - camera.y);
    }
    ctx.shadowBlur = 0;
  }

  // Corrupted Heart — planted in place like a large tree stump, no floating/bobbing.
  // Drawn via a real <img> (corruptedHeartGifPool) so its GIF animation actually plays;
  // drawImage()'ing a GIF onto canvas freezes it on the first frame.
  const hSize = TILE * CORRUPTED_HEART_TILE_SPAN;
  corruptedHeartGifPool.forEach((el, i) => {
    if (i < corruptedHearts.length) {
      const h = corruptedHearts[i];
      el.style.display = 'block';
      el.style.left = Math.round(h.x * TILE - camera.x) + 'px';
      el.style.top = Math.round(h.y * TILE - camera.y) + 'px';
      el.style.width = hSize + 'px';
      el.style.height = hSize + 'px';
    } else {
      el.style.display = 'none';
    }
  });
  for (const h of corruptedHearts) {
    const hpx = h.x * TILE - camera.x, hpy = h.y * TILE - camera.y;
    const barW = TILE * 5, barH = 10;
    const bpx = hpx + hSize/2 - barW/2;
    const bpy = hpy - barH - 18;
    ctx.fillStyle = "#000"; ctx.fillRect(bpx - 1, bpy - 1, barW + 2, barH + 2);
    const hpct = Math.max(0, h.hp / h.maxHp);
    ctx.fillStyle = hpct > 0.5 ? "#ff0066" : hpct > 0.25 ? "#ff4488" : "#ffff00";
    ctx.fillRect(bpx, bpy, barW * hpct, barH);
    ctx.strokeStyle = "#ffffff44"; ctx.lineWidth = 1;
    ctx.strokeRect(bpx, bpy, barW, barH);
    ctx.font = "9px 'Share Tech Mono'"; ctx.textAlign = "center"; ctx.fillStyle = "#fff";
    ctx.fillText(`CORRUPTED HEART ${Math.ceil(h.hp)}/${h.maxHp}`, bpx + barW/2, bpy - 4);
  }

  // Enemies — rendered with inverted colors while any Corrupted Heart is alive
  const eSize = TILE * 1.8;
  const eOff = (TILE - eSize) / 2;
  ctx.font = TILE * 0.8 + "px serif";
  if (corruptedHearts.length > 0) ctx.filter = "invert(1)";
  for (const e of enemies) {
    const sImg = skullImgs[e.skullIdx ?? 0];
    if (sImg.complete && sImg.naturalWidth > 0) {
      ctx.drawImage(sImg, e.x * TILE - camera.x + eOff, e.y * TILE - camera.y + eOff, eSize, eSize);
    } else {
      ctx.fillText(e.emoji, e.x * TILE + TILE / 2 - camera.x, e.y * TILE + TILE / 2 - camera.y);
    }
  }
  ctx.filter = "none";

  // Projectiles
  ctx.font = TILE * 0.7 + "px serif";
  for (const p of projectiles) {
    ctx.fillText("⚡", p.x * TILE + TILE / 2 - camera.x, p.y * TILE + TILE / 2 - camera.y);
  }

  // Fireballs
  for (const f of fireballs) {
    const fpx = f.x * TILE + TILE / 2 - camera.x;
    const fpy = f.y * TILE + TILE / 2 - camera.y;
    const pulse = 0.85 + 0.15 * Math.sin(frameCount * 0.3);
    ctx.globalAlpha = pulse;
    ctx.shadowColor = "#ff4400"; ctx.shadowBlur = 6;
    if (fireballImg.complete && fireballImg.naturalWidth > 0) {
      const fsz = TILE * 3;
      ctx.drawImage(fireballImg, fpx - fsz/2, fpy - fsz/2, fsz, fsz);
    } else {
      ctx.font = (TILE * 2.8) + "px serif";
      ctx.textAlign = "center"; ctx.textBaseline = "middle";
      ctx.fillText("🔥", fpx, fpy);
    }
    ctx.shadowBlur = 0; ctx.globalAlpha = 1;
  }

  // Demons
  for (const d of demons) {
    const dSize = TILE * 4;
    const dpx = d.x * TILE + TILE/2 - camera.x - dSize/2;
    const dpy = d.y * TILE + TILE/2 - camera.y - dSize/2;
    const bob = Math.sin(frameCount * 0.07 + d.x) * 5;
    ctx.shadowColor = "#ff2200"; ctx.shadowBlur = 10;
    if (demonImg.complete && demonImg.naturalWidth > 0) {
      ctx.drawImage(demonImg, dpx, dpy + bob, dSize, dSize);
    } else {
      ctx.font = dSize + "px serif";
      ctx.textAlign = "center"; ctx.textBaseline = "middle";
      ctx.fillText("👿", d.x * TILE + TILE/2 - camera.x, d.y * TILE + TILE/2 - camera.y + bob);
    }
    ctx.shadowBlur = 0;
    const barW = TILE * 3, barH = 8;
    const bpx = d.x * TILE - camera.x + TILE/2 - barW/2;
    const bpy = d.y * TILE - camera.y - dSize/2 - 18 + bob;
    ctx.fillStyle = "#000"; ctx.fillRect(bpx - 1, bpy - 1, barW + 2, barH + 2);
    const pct = Math.max(0, d.hp / d.maxHp);
    ctx.fillStyle = pct > 0.5 ? "#ff4400" : pct > 0.25 ? "#ff8800" : "#ffff00";
    ctx.fillRect(bpx, bpy, barW * pct, barH);
    ctx.strokeStyle = "#ffffff44"; ctx.lineWidth = 1;
    ctx.strokeRect(bpx, bpy, barW, barH);
    ctx.font = "9px 'Share Tech Mono'"; ctx.textAlign = "center"; ctx.fillStyle = "#fff";
    ctx.fillText(`DEMON ${Math.ceil(d.hp)}/${d.maxHp}`, bpx + barW/2, bpy - 4);
  }

  // Bosses — flip horizontally when moving right
  for (const b of bosses) {
    const isBoss5 = b.imgIdx === 4;
    const bossW = isBoss5 ? TILE * 9 : TILE * 3;
    const bossH = isBoss5 ? TILE * 6 : TILE * 3;
    const bx3 = b.x * TILE + TILE/2 - camera.x - bossW/2;
    const by3 = b.y * TILE + TILE/2 - camera.y - bossH/2;
    ctx.save();
    if (b.facingRight) {
      ctx.translate(bx3 + bossW / 2, by3 + bossH / 2);
      ctx.scale(-1, 1);
      ctx.translate(-(bx3 + bossW / 2), -(by3 + bossH / 2));
    }
    const bImg = bossImgs[b.imgIdx];
    if (bImg.complete && bImg.naturalWidth > 0) {
      ctx.drawImage(bImg, bx3, by3, bossW, bossH);
    } else {
      ctx.font = bossW + "px serif";
      ctx.textAlign = "center"; ctx.textBaseline = "middle";
      ctx.fillText("👹", b.x * TILE + TILE / 2 - camera.x, b.y * TILE + TILE / 2 - camera.y);
    }
    ctx.restore();
    drawBossHealth(b);
  }

  // Player
  if (purpleTimer > 0) {
    const vAlpha = 0.1 + 0.07 * Math.sin(frameCount * 0.25);
    ctx.fillStyle = `rgba(100,0,200,${vAlpha})`;
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    if (frameCount % 3 === 0) {
      ctx.strokeStyle = `rgba(180,80,255,${0.3 + 0.2 * Math.random()})`;
      ctx.lineWidth = 1.5; ctx.beginPath();
      ctx.moveTo(player.x * TILE + TILE/2 - camera.x, player.y * TILE + TILE/2 - camera.y);
      ctx.lineTo(Math.random() * canvas.width, Math.random() * canvas.height);
      ctx.stroke();
    }
    const purpleSize = TILE * 2;
    const ppx2 = player.x * TILE + TILE/2 - camera.x - purpleSize/2;
    const ppy2 = player.y * TILE + TILE/2 - camera.y - purpleSize/2;
    hudPurpleGifEl.style.display = "block";
    hudPurpleGifEl.style.left = Math.round(ppx2) + "px";
    hudPurpleGifEl.style.top = Math.round(ppy2) + "px";
    hudPurpleGifEl.style.width = purpleSize + "px";
    hudPurpleGifEl.style.height = purpleSize + "px";
    if (!_purpleFilterSet) { hudPurpleGifEl.style.filter = "drop-shadow(0 0 8px #cc44ff)"; _purpleFilterSet = true; }
  } else {
    hudPurpleGifEl.style.display = "none";
    _purpleFilterSet = false;
  }
  if (rageTimer > 0) {
    const rageSize = TILE * 2;
    const rpx = player.x * TILE + TILE/2 - camera.x - rageSize/2;
    const rpy = player.y * TILE + TILE/2 - camera.y - rageSize/2;
    const vAlpha = 0.12 + 0.08 * Math.sin(frameCount * 0.2);
    ctx.fillStyle = `rgba(255,30,0,${vAlpha})`;
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    hudRageGifEl.style.display = "block";
    hudRageGifEl.style.left = Math.round(rpx) + "px";
    hudRageGifEl.style.top = Math.round(rpy) + "px";
    hudRageGifEl.style.width = rageSize + "px";
    hudRageGifEl.style.height = rageSize + "px";
    if (!_rageFilterSet) { hudRageGifEl.style.filter = "drop-shadow(0 0 10px #ff2200)"; _rageFilterSet = true; }
    const pSize = TILE * 1.2;
    const spx = player.x * TILE + TILE/2 - camera.x - pSize/2;
    const spy = player.y * TILE + TILE/2 - camera.y - pSize/2;
    hudRageSkinEl.src = playerImg.src;
    hudRageSkinEl.style.display = "block";
    hudRageSkinEl.style.left = Math.round(spx) + "px";
    hudRageSkinEl.style.top = Math.round(spy) + "px";
    hudRageSkinEl.style.width = pSize + "px";
    hudRageSkinEl.style.height = pSize + "px";
    hudRageSkinEl.style.opacity = (player.invincible > 0 && Math.floor(frameCount / 3) % 2 === 0) ? "0.4" : "1";
  } else {
    hudRageGifEl.style.display = "none";
    hudRageSkinEl.style.display = "none";
    _rageFilterSet = false;
    if (purpleTimer <= 0) {
      if (player.invincible > 0 && Math.floor(frameCount / 3) % 2 === 0) ctx.globalAlpha = 0.4;
      if (playerImg.complete && playerImg.naturalWidth > 0) {
        const pSize = TILE * 1.2;
        ctx.drawImage(playerImg,
          player.x * TILE + TILE/2 - camera.x - pSize/2,
          player.y * TILE + TILE/2 - camera.y - pSize/2,
          pSize, pSize);
      } else {
        ctx.font = TILE + "px serif";
        ctx.textAlign = "center"; ctx.textBaseline = "middle";
        ctx.fillText(player.hp > 0 ? "🤖" : "☠️", player.x * TILE + TILE/2 - camera.x, player.y * TILE + TILE/2 - camera.y);
      }
      ctx.globalAlpha = 1;
    }
  }

  // Active 2x Clone
  if (activeClone) {
    const cSize = TILE * 1.2;
    const cpx = activeClone.x * TILE + TILE/2 - camera.x - cSize/2;
    const cpy = activeClone.y * TILE + TILE/2 - camera.y - cSize/2;
    ctx.save();
    ctx.shadowColor = "#00ffff"; ctx.shadowBlur = 14;
    ctx.globalAlpha = 0.85 + 0.15 * Math.sin(frameCount * 0.15);
    if (playerImg.complete && playerImg.naturalWidth > 0) ctx.drawImage(playerImg, cpx, cpy, cSize, cSize);
    ctx.restore();
    ctx.shadowBlur = 0;
    // Lifetime bar
    const barW = TILE * 2;
    const barX = activeClone.x * TILE + TILE/2 - camera.x - barW/2;
    const barY = activeClone.y * TILE - camera.y - cSize/2 - 10;
    const pct = activeClone.lifetime / CLONE_2X_LIFETIME;
    ctx.fillStyle = "#001122"; ctx.fillRect(barX - 1, barY - 1, barW + 2, 6);
    ctx.fillStyle = pct > 0.5 ? "#00ffff" : pct > 0.25 ? "#88ffff" : "#ff8800";
    ctx.fillRect(barX, barY, barW * pct, 4);
    ctx.font = "bold 9px 'Share Tech Mono'"; ctx.textAlign = "center";
    ctx.fillStyle = "#00ffff"; ctx.shadowColor = "#00ffff"; ctx.shadowBlur = 5;
    ctx.fillText("2X", activeClone.x * TILE + TILE/2 - camera.x, barY - 3);
    ctx.shadowBlur = 0;
  }

  drawParticles();

  // Rainbow flicker overlay
  if (rainbowFlicker > 0) {
    const progress = rainbowFlicker / RAINBOW_FLICKER_DURATION;
    const hue = (frameCount * 18) % 360;
    ctx.fillStyle = `hsla(${hue},100%,55%,${0.28 * progress})`;
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = `hsla(${(hue + 120) % 360},100%,55%,${0.15 * progress})`;
    ctx.fillRect(0, 0, canvas.width, canvas.height);
  }

  // Day/Night overlay
  if (darkness > 0) {
    ctx.fillStyle = `rgba(0,5,30,${darkness})`;
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Stars
    if (darkness > 0.4) {
      for (let s = 0; s < 80; s++) {
        const sx2 = ((s * 173 + frameCount * 0.5) % canvas.width);
        const sy2 = ((s * 97) % (canvas.height * 0.6));
        const twinkle = 0.5 + 0.5 * Math.sin(frameCount * 0.05 + s);
        ctx.globalAlpha = twinkle * (darkness - 0.4) * 2;
        ctx.fillStyle = "#ffffff";
        ctx.fillRect(sx2, sy2, 1.5, 1.5);
      }
      ctx.globalAlpha = 1;
    }
  }

  // HUD — only touch DOM when values actually change
  const hpCeil = Math.ceil(player.hp);
  if (hpCeil !== _hudHp) {
    _hudHp = hpCeil;
    hudHpFill.style.width = Math.max(0, player.hp / player.maxHp * 100) + "%";
    hudHpVal.textContent = hpCeil;
  }
  if (score !== _hudScore)  { _hudScore = score;   hudScoreVal.textContent = score; }
  if (level !== _hudLevel)  { _hudLevel = level;   hudLevelVal.textContent = level; }
  const best = getBestScore();
  if (best  !== _hudBest)   { _hudBest  = best;    hudBestVal.textContent  = best; }
  const sec = Math.ceil(bossTimer / 60);
  const newBossText = peacefulMode ? "🕊" : `${Math.floor(sec/60)}:${(sec%60).toString().padStart(2,"0")}`;
  if (newBossText !== _hudBossTimerText) { _hudBossTimerText = newBossText; hudBossTimerVal.textContent = newBossText; }
  const dl = getDayLabel();
  if (dl.text  !== _hudDayLabel) { _hudDayLabel = dl.text;  hudDayPhaseLbl.textContent = dl.text; }
  if (dl.color !== _hudDayColor) { _hudDayColor = dl.color; hudDayPhaseLbl.style.color = dl.color; }
  drawDayBar();

  // Rage HUD
  if (rageStored || rageTimer > 0) {
    hudRageSection.style.display = "flex";
    if (rageTimer > 0) {
      hudRageFill.style.width = (rageTimer / RAGE_DURATION * 100) + "%";
      hudRageFill.style.background = "linear-gradient(90deg,#ff2200,#ff8800)";
      hudRageLabel.textContent = Math.ceil(rageTimer / 60) + "s";
      hudRageLabel.style.color = "#ff4400";
    } else {
      hudRageFill.style.width = "100%";
      hudRageFill.style.background = "linear-gradient(90deg,#ff6600,#ffcc00)";
      hudRageLabel.textContent = "READY";
      hudRageLabel.style.color = "#ffcc00";
    }
  } else {
    hudRageSection.style.display = "none";
  }

  // Purple HUD
  if (purpleStored || purpleTimer > 0) {
    hudPurpleSection.style.display = "flex";
    if (purpleTimer > 0) {
      hudPurpleFill.style.width = (purpleTimer / PURPLE_ELEC_DURATION * 100) + "%";
      hudPurpleLabel.textContent = Math.ceil(purpleTimer / 60) + "s";
      hudPurpleLabel.style.color = "#cc44ff";
    } else {
      hudPurpleFill.style.width = "100%";
      hudPurpleLabel.textContent = "READY";
      hudPurpleLabel.style.color = "#dd88ff";
    }
  } else {
    hudPurpleSection.style.display = "none";
  }

  // Clone 2x HUD
  if (activeClone) {
    hudClone2xSection.style.display = "flex";
    hudClone2xSep.style.display = "";
    hudClone2xFill.style.width = (activeClone.lifetime / CLONE_2X_LIFETIME * 100) + "%";
    hudClone2xLabel.textContent = Math.ceil(activeClone.lifetime / 60) + "s";
  } else {
    hudClone2xSection.style.display = "none";
    hudClone2xSep.style.display = "none";
  }

  if (paused) {
    hudRageGifEl.style.display = "none";
    hudPurpleGifEl.style.display = "none";
    drawPauseOverlay();
  }

  if (player.hp <= 0) {
    hudRageGifEl.style.display = "none";
    hudPurpleGifEl.style.display = "none";
    if (!_deadPlayed) {
      _deadPlayed = true;
      document.getElementById("bgMusic").pause();
      const deadSound = document.getElementById("deadSound");
      deadSound.volume = 0.8;
      deadSound.currentTime = 0;
      deadSound.play().catch(() => {});
      const curBest = getBestScore();
      if (score > curBest) saveBestScore(score);
    }
    const curBest = getBestScore();
    hudFinalScore.textContent =
      `Score: ${score} | Level: ${level}${score >= curBest && score > 0 ? " | 🏆 NEW BEST!" : " | Best: " + curBest}`;
    hudGameOverScreen.style.display = "flex";
  }
}

function updateCooldowns() {
  for (const k in actionCooldown) {
    actionCooldown[k]--;
    if (actionCooldown[k] <= 0) delete actionCooldown[k];
  }
  if (player.invincible > 0) player.invincible--;
}

function togglePause() {
  paused = !paused;
  const btn = document.getElementById("pauseBtn");
  const music = document.getElementById("bgMusic");
  if (paused) {
    btn.textContent = "▶ RESUME";
    btn.style.color = "#ffd700";
    btn.style.borderColor = "#ffd700";
    music.pause();
  } else {
    btn.textContent = "⏸ PAUSE";
    btn.style.color = "#88ff88";
    btn.style.borderColor = "#1a4a1a";
    music.play().catch(() => {});
    if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
    loop();
  }
}

function drawPauseOverlay() {
  ctx.fillStyle = "rgba(0,0,0,0.82)";
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  ctx.textAlign = "center"; ctx.textBaseline = "middle";

  // Title
  ctx.font = "bold 22px 'Press Start 2P', monospace";
  ctx.fillStyle = "#ffd700";
  ctx.shadowColor = "#ffd700"; ctx.shadowBlur = 16;
  ctx.fillText("PAUSED", canvas.width / 2, canvas.height / 2 - 160);
  ctx.shadowBlur = 0;

  // Controls list
  const controls = [
    ["MOVEMENT",    "Arrows or WASD"],
    ["LIGHTNING",   "Space"],
    ["PLACE ROCK",  "B"],
    ["PLACE TREE",  "Y"],
    ["PLACE CACTUS","R"],
    ["PLACE MUSHROOM","U"],
    ["PLACE FIRE",  "F"],
    ["PLACE IRON",  "T"],
    ["PLACE DOOR",  "G"],
    ["PLACE LAVA",  "H"],
    ["MUTE",        "M"],
    ["PAUSE",       "Pause Button"],
  ];

  const startY = canvas.height / 2 - 100;
  const lineH = 28;
  ctx.font = "10px 'Share Tech Mono', monospace";

  controls.forEach(([action, key], idx) => {
    const y = startY + idx * lineH;
    // Key on left
    ctx.textAlign = "right";
    ctx.fillStyle = "#88ff88";
    ctx.fillText(key, canvas.width / 2 - 16, y);
    // Action on right
    ctx.textAlign = "left";
    ctx.fillStyle = "#448844";
    ctx.fillText(action, canvas.width / 2 + 16, y);
  });

  // Resume hint
  ctx.textAlign = "center";
  ctx.font = "10px 'Share Tech Mono', monospace";
  ctx.fillStyle = "#336633";
  ctx.fillText("click RESUME to continue", canvas.width / 2, startY + controls.length * lineH + 20);
}

// ─── MYSTERY POWERUP ─────────────────────────────────────────
function updateMystery() {
  mysteryPickupSpawn--;
  if (mysteryPickupSpawn <= 0) {
    mysteryPickupSpawn = MYSTERY_SPAWN_INTERVAL;
    const angle = Math.random() * Math.PI * 2;
    const dist = 8 + Math.floor(Math.random() * 10);
    const px = player.x + Math.round(Math.cos(angle) * dist);
    const py = player.y + Math.round(Math.sin(angle) * dist);
    if (getTile(px, py) === 0)
      mysteryPickups.push({ x: px, y: py, ttl: 20 * 60, swapTimer: 0, iconIdx: 0 });
  }

  for (let i = mysteryPickups.length - 1; i >= 0; i--) {
    const m = mysteryPickups[i];
    m.ttl--;
    if (m.ttl <= 0) { mysteryPickups.splice(i, 1); continue; }

    // Cycle icon every 0.5s
    m.swapTimer++;
    if (m.swapTimer >= MYSTERY_SWAP_RATE) {
      m.swapTimer = 0;
      m.iconIdx = (m.iconIdx + 1) % 4;
    }

    if (m.x === player.x && m.y === player.y) {
      mysteryPickups.splice(i, 1);
      // Grant the powerup matching current icon
      switch (m.iconIdx) {
        case 0: // rage
          rageStored = true;
          spawnParticles(player.x, player.y, "#ff6600", 10, 2);
          showToast("🎲 MYSTERY: 😡 RAGE READY — Press SPACE!");
          break;
        case 1: // purple
          purpleStored = true;
          spawnParticles(player.x, player.y, "#cc44ff", 10, 2);
          showToast("🎲 MYSTERY: ⚡ PURPLE STORM READY — Press SPACE!");
          break;
        case 2: // rainbow
          const killed = enemies.length;
          for (let j = enemies.length - 1; j >= 0; j--) {
            spawnParticles(enemies[j].x, enemies[j].y, `hsl(${Math.random()*360},100%,60%)`, 6, 2);
            xp += enemies[j].xp; score += enemies[j].xp * 10;
            enemies.splice(j, 1);
          }
          player.hp = Math.min(player.hp + killed, player.maxHp);
          rainbowFlicker = RAINBOW_FLICKER_DURATION;
          rainbowSpawnSuppressTimer = 20 * 60;
          checkLevelUp();
          showToast("🎲 MYSTERY: 🌈 RAINBOW POWER!");
          showRainbowAlert();
          const rbs2 = document.getElementById("rainbowSound");
          rbs2.currentTime = 0; rbs2.play().catch(() => {});
          break;
        case 3: // wrench
          const heal = Math.round(player.maxHp * 0.25);
          player.hp = Math.min(player.hp + heal, player.maxHp);
          spawnParticles(player.x, player.y, "#44ff88", 12, 2);
          spawnTextParticle(player.x, player.y - 1, `+${heal} HP`, "#44ff88");
          showToast(`🎲 MYSTERY: 🔧 REPAIRED! +${heal} HP`);
          const ws2 = document.getElementById("wrenchSound");
          ws2.currentTime = 0; ws2.play().catch(() => {});
          break;
      }
    }
  }
}

// ─── 2X CLONE FUNCTIONS ──────────────────────────────────────
function findNearestTarget(fromX, fromY) {
  let nearestDist = Infinity, targetX = null, targetY = null;
  for (const e of enemies) {
    const d = Math.abs(e.x - fromX) + Math.abs(e.y - fromY);
    if (d < nearestDist) { nearestDist = d; targetX = e.x; targetY = e.y; }
  }
  for (const b of bosses) {
    const d = Math.abs(b.x - fromX) + Math.abs(b.y - fromY);
    if (d < nearestDist) { nearestDist = d; targetX = b.x; targetY = b.y; }
  }
  for (const d of demons) {
    const dist = Math.abs(d.x - fromX) + Math.abs(d.y - fromY);
    if (dist < nearestDist) { nearestDist = dist; targetX = d.x; targetY = d.y; }
  }
  for (const a of aliens) {
    const d = Math.abs(a.x - fromX) + Math.abs(a.y - fromY);
    if (d < nearestDist) { nearestDist = d; targetX = a.x; targetY = a.y; }
  }
  return { targetX, targetY, dist: nearestDist };
}

function updateClone2x() {
  // Spawn pickup
  clone2xPickupSpawn--;
  if (clone2xPickupSpawn <= 0) {
    clone2xPickupSpawn = CLONE_2X_SPAWN_INTERVAL;
    const angle = Math.random() * Math.PI * 2;
    const dist = 8 + Math.floor(Math.random() * 10);
    const px = player.x + Math.round(Math.cos(angle) * dist);
    const py = player.y + Math.round(Math.sin(angle) * dist);
    if (getTile(px, py) === 0) clone2xPickups.push({ x: px, y: py, ttl: 20 * 60 });
  }

  // Pickup collection
  for (let i = clone2xPickups.length - 1; i >= 0; i--) {
    const p = clone2xPickups[i];
    p.ttl--;
    if (p.ttl <= 0) { clone2xPickups.splice(i, 1); continue; }
    if (p.x === player.x && p.y === player.y) {
      clone2xPickups.splice(i, 1);
      activeClone = { x: player.x, y: player.y, lifetime: CLONE_2X_LIFETIME, moveTimer: 0, shootTimer: 0 };
      spawnParticles(player.x, player.y, "#00ffff", 16, 2.5);
      showToast("🤖×2 CLONE SPAWNED! 60s");
    }
  }

  if (!activeClone) return;
  activeClone.lifetime--;
  if (activeClone.lifetime <= 0) {
    spawnParticles(activeClone.x, activeClone.y, "#00ffff", 10, 2);
    showToast("🤖 Clone expired");
    activeClone = null;
    return;
  }

  const { targetX, targetY } = findNearestTarget(activeClone.x, activeClone.y);

  // Move toward nearest target
  activeClone.moveTimer--;
  if (activeClone.moveTimer <= 0 && targetX !== null) {
    activeClone.moveTimer = CLONE_2X_MOVE_RATE;
    const dx = Math.sign(targetX - activeClone.x), dy = Math.sign(targetY - activeClone.y);
    for (const [ndx, ndy] of [[dx, dy],[dx, 0],[0, dy]]) {
      const nx = activeClone.x + ndx, ny = activeClone.y + ndy;
      if (getTile(nx, ny) !== "iron") { activeClone.x = nx; activeClone.y = ny; break; }
    }
  }

  // Shoot toward nearest target
  activeClone.shootTimer--;
  if (activeClone.shootTimer <= 0 && targetX !== null) {
    activeClone.shootTimer = CLONE_2X_SHOOT_RATE;
    const ddx = targetX - activeClone.x, ddy = targetY - activeClone.y;
    const len = Math.sqrt(ddx * ddx + ddy * ddy) || 1;
    const sdx = Math.round(ddx / len), sdy = Math.round(ddy / len);
    if (sdx !== 0 || sdy !== 0) {
      projectiles.push({ x: activeClone.x, y: activeClone.y, dx: sdx, dy: sdy, dist: 0, type: "lightning" });
      spawnParticles(activeClone.x, activeClone.y, "#00ffff", 3, 1.2);
    }
  }
}

// ─── ALIEN SPAWNER SYSTEM ────────────────────────────────────
function countMushroomsNear(cx, cy, radius) {
  let count = 0;
  for (let dx = -radius; dx <= radius; dx++)
    for (let dy = -radius; dy <= radius; dy++)
      if (getTileRaw(cx + dx, cy + dy) === "🍄") count++;
  return count;
}

function spawnAlienSpawnerAt(x, y) {
  for (const s of alienSpawners) {
    if (Math.abs(s.x - x) < 5 && Math.abs(s.y - y) < 5) return;
    if (s.defeated && Math.abs(s.x - x) < 10 && Math.abs(s.y - y) < 10) return;
  }
  alienSpawners.push({ x, y, spawnTimer: 0, hp: ALIEN_SPAWNER_HP, maxHp: ALIEN_SPAWNER_HP, defeated: false });
  spawnParticles(x, y, "#aa44ff", 16, 2.5);
  showToast("👽 ALIEN SPAWNER APPEARED!");
}

function checkMushroomSpawner(mx, my) {
  // Count mushrooms within 5 tiles of the placed mushroom
  const count = countMushroomsNear(mx, my, 5);
  if (count >= 10) spawnAlienSpawnerAt(mx, my);
}

function updateAliens() {
  if (peacefulMode) return;

  // Periodically scan mushroom biome for natural spawners
  alienSpawnerCheckTimer--;
  if (alienSpawnerCheckTimer <= 0) {
    alienSpawnerCheckTimer = ALIEN_SPAWNER_CHECK_INTERVAL;
    // Check tiles near player in mushroom biome
    for (let dx = -30; dx <= 30; dx += 5) {
      for (let dy = -30; dy <= 30; dy += 5) {
        const tx = player.x + dx, ty = player.y + dy;
        if (biome(tx, ty) === "mushroom") {
          const count = countMushroomsNear(tx, ty, 5);
          if (count >= 6 && Math.random() < 0.08) {
            spawnAlienSpawnerAt(tx, ty);
          }
        }
      }
    }
  }

  // Update each spawner
  for (let i = alienSpawners.length - 1; i >= 0; i--) {
    const s = alienSpawners[i];
    // Remove live (non-defeated) spawner if mushrooms are gone
    if (!s.defeated && countMushroomsNear(s.x, s.y, 8) < 3) {
      spawnParticles(s.x, s.y, "#aa44ff", 10, 2);
      alienSpawners.splice(i, 1);
      continue;
    }
    if (s.defeated) continue;
    // Spawn aliens
    const myAliens = aliens.filter(a => a.homeX === s.x && a.homeY === s.y);
    s.spawnTimer--;
    if (s.spawnTimer <= 0 && myAliens.length < ALIEN_MAX_PER_SPAWNER) {
      s.spawnTimer = ALIEN_SPAWN_RATE;
      const type = Math.random() < 0.5 ? 1 : 2;
      const angle = Math.random() * Math.PI * 2;
      const dist = 2 + Math.floor(Math.random() * 3);
      const ax = s.x + Math.round(Math.cos(angle) * dist);
      const ay = s.y + Math.round(Math.sin(angle) * dist);
      aliens.push({
        x: ax, y: ay, type,
        hp: type === 1 ? 2 : 3, maxHp: type === 1 ? 2 : 3,
        curHp: type === 1 ? 2 : 3,
        speed: type === 1 ? 25 : 35,
        dmg: type === 1 ? 5 : 8,
        xp: type === 1 ? 2 : 3,
        timer: 0,
        homeX: s.x, homeY: s.y,
      });
    }
  }

  // Update each alien
  for (let i = aliens.length - 1; i >= 0; i--) {
    const a = aliens[i];
    a.timer--;
    if (a.timer > 0) continue;
    a.timer = a.speed;

    const distToHome = Math.abs(a.x - a.homeX) + Math.abs(a.y - a.homeY);
    const distToPlayer = Math.abs(a.x - player.x) + Math.abs(a.y - player.y);

    let targetX = player.x, targetY = player.y;

    // If too far from home, drift back
    if (distToHome > ALIEN_ROAM_RADIUS) {
      targetX = a.homeX; targetY = a.homeY;
    }

    const dx = Math.sign(targetX - a.x), dy = Math.sign(targetY - a.y);
    for (const [ndx, ndy] of [[dx, dy],[dx, 0],[0, dy]]) {
      const nx = a.x + ndx, ny = a.y + ndy;
      const tile = getTile(nx, ny);
      if (tile === "iron" || tile === "door" || tile === "yellow_block") continue;
      if (tile !== 0 && tile !== "lava" && tile !== "🔥" && tile !== "🍄") setTile(nx, ny, 0);
      a.x = nx; a.y = ny; break;
    }

    // Damage player
    if (a.x === player.x && a.y === player.y && player.invincible <= 0) {
      player.hp -= a.dmg;
      player.invincible = 20;
      shakeTimer = 10;
      playOuch();
    }
  }
}

function updateAlienProjectiles() {
  // Check lightning/rage hitting aliens
  for (let i = aliens.length - 1; i >= 0; i--) {
    const a = aliens[i];
    for (let j = projectiles.length - 1; j >= 0; j--) {
      const p = projectiles[j];
      if (Math.round(p.x) === a.x && Math.round(p.y) === a.y) {
        a.curHp--;
        if (a.curHp <= 0) {
          spawnParticles(a.x, a.y, "#aa44ff", 6, 2);
          spawnTextParticle(a.x, a.y, `+${a.xp}XP`);
          xp += a.xp; score += a.xp * 10;
          aliens.splice(i, 1);
          checkLevelUp();
        }
        projectiles.splice(j, 1);
        break;
      }
    }
  }
  // Rage kills aliens in range
  if (rageTimer > 0 && frameCount % 4 === 0) {
    for (let i = aliens.length - 1; i >= 0; i--) {
      const a = aliens[i];
      if (Math.abs(a.x - player.x) <= 2 && Math.abs(a.y - player.y) <= 2) {
        spawnParticles(a.x, a.y, "#aa44ff", 5, 1.5);
        xp += a.xp; score += a.xp * 10;
        aliens.splice(i, 1);
        checkLevelUp();
      }
    }
    for (const s of alienSpawners) {
      if (!s.defeated && Math.abs(s.x - player.x) <= 3 && Math.abs(s.y - player.y) <= 3) {
        s.hp -= 2;
        spawnParticles(s.x, s.y, "#ff4400", 3, 1);
        if (s.hp <= 0) {
          s.hp = 0; s.defeated = true;
          spawnParticles(s.x, s.y, "#aa44ff", 16, 2.5);
          showToast("👽 ALIEN SPAWNER DESTROYED!");
        }
      }
    }
  }
  // Purple kills aliens
  if (purpleTimer > 0 && frameCount % 6 === 0) {
    for (let i = aliens.length - 1; i >= 0; i--) {
      spawnParticles(aliens[i].x, aliens[i].y, "#cc44ff", 4, 1.5);
      xp += aliens[i].xp; score += aliens[i].xp * 10;
      aliens.splice(i, 1);
      checkLevelUp();
    }
    for (const s of alienSpawners) {
      if (!s.defeated) {
        s.hp -= 3;
        spawnParticles(s.x, s.y, "#cc44ff", 4, 1.5);
        if (s.hp <= 0) {
          s.hp = 0; s.defeated = true;
          spawnParticles(s.x, s.y, "#aa44ff", 16, 2.5);
          showToast("👽 ALIEN SPAWNER DESTROYED!");
        }
      }
    }
  }
}

// ─── MINI GAME ───────────────────────────────────────────────
let miniActive = false;
let miniRaf = null;
let miniKeys = {};

const miniGame = {
  bgImg: null, bgPixels: null, bgW: 500, bgH: 600,
  bgVisualImg: null,
  px: 0, py: 0, pvx: 0, pvy: 0, pW: 40, pH: 40, onGround: false,
  playerImg: null,
  bx: 0, by: 0, bvx: 1.5, bW: 48, bH: 48, badImg: null, bFloor: 0,
  b2x: 0, b2y: 0, b2vx: 1.5, b2vy: 0, b2W: 48, b2H: 48, bad2Img: null, b2onGround: false, b2found: false,
  goalX: 0, goalY: 0, goalW: 32, goalH: 32,
};

function miniColorAt(x, y) {
  if (!miniGame.bgPixels) return null;
  const xi = Math.round(x), yi = Math.round(y);
  if (xi < 0 || xi >= miniGame.bgW || yi < 0 || yi >= miniGame.bgH) return null;
  const idx = (yi * miniGame.bgW + xi) * 4;
  const d = miniGame.bgPixels.data;
  return { r: d[idx], g: d[idx+1], b: d[idx+2] };
}
function miniColorMatch(c, r, g, b, tol = 40) {
  if (!c) return false;
  return Math.abs(c.r-r)<tol && Math.abs(c.g-g)<tol && Math.abs(c.b-b)<tol;
}
function miniIsGround(x, y) {
  return miniColorMatch(miniColorAt(x, y), 0, 255, 0);
}

function openMiniGame() {
  if (miniActive) return;
  miniActive = true;
  if (!paused) { paused = true; document.getElementById("bgMusic").pause(); }
  document.getElementById("miniGameOverlay").style.display = "flex";
  miniKeys = {};
  const mg = miniGame;
  const mc = document.getElementById("miniCanvas");
  const mctx = mc.getContext("2d");

  // Preload all four images, start loop only when all are ready
  let loaded = 0;
  const total = 5;
  function onLoad() {
    loaded++;
    if (loaded < total) return;
    // All loaded — scan background for color markers
    const off = document.createElement("canvas");
    off.width = mg.bgW; off.height = mg.bgH;
    const octx = off.getContext("2d");
    octx.drawImage(mg.bgImg, 0, 0, mg.bgW, mg.bgH);
    mg.bgPixels = octx.getImageData(0, 0, mg.bgW, mg.bgH);
    let spawnFound = false, goalFound = false, enemyFound = false, enemy2Found = false;
    for (let y = 0; y < mg.bgH && !(spawnFound && goalFound && enemyFound && enemy2Found); y++) {
      for (let x = 0; x < mg.bgW; x++) {
        const c = miniColorAt(x, y);
        if (!spawnFound && miniColorMatch(c, 0, 0, 255))   { mg.px = x - mg.pW/2; mg.py = y - mg.pH; spawnFound = true; }
        if (!goalFound  && miniColorMatch(c, 0, 255, 255)) { mg.goalX = x - mg.goalW/2; mg.goalY = y - mg.goalH; goalFound = true; }
        if (!enemyFound && miniColorMatch(c, 255, 0, 0)) {
          let dropY = y;
          while (dropY < mg.bgH && !miniColorMatch(miniColorAt(x, dropY), 0, 255, 0)) dropY++;
          mg.bx = x - mg.bW/2; mg.by = dropY - mg.bH; enemyFound = true;
        }
        if (!enemy2Found && miniColorMatch(c, 255, 255, 0)) {
          // b2 starts at yellow marker, falls with gravity — no snap needed
          mg.b2x = x - mg.b2W/2; mg.b2y = y - mg.b2H;
          mg.b2vy = 0; mg.b2found = true; enemy2Found = true;
        }
      }
    }
    mg.pvx = 0; mg.pvy = 0;
    mg.bFloor = mg.by + mg.bH;
    startMiniLoop(mc, mctx);
  }

  mg.bgImg = new Image();
  mg.bgImg.onload = onLoad;
  mg.bgImg.src = 'png/minigamebg.png';

  mg.playerImg = new Image();
  mg.playerImg.onload = onLoad;
  mg.playerImg.src = 'png/bossfavicon.png';

  mg.badImg = new Image();
  mg.badImg.onload = onLoad;
  mg.badImg.src = 'png/badguy.png';

  mg.bad2Img = new Image();
  mg.bad2Img.onload = onLoad;
  mg.bad2Img.src = 'png/badguy2.png';

  mg.bgVisualImg = new Image();
  mg.bgVisualImg.onload = onLoad;
  mg.bgVisualImg.src = 'png/minigamebg_visual.png';

  document.addEventListener("keydown", miniKeyDown);
  document.addEventListener("keyup", miniKeyUp);
}

function miniKeyDown(e) {
  miniKeys[e.key.toLowerCase()] = true;
  if (e.key === " " || e.key.startsWith("Arrow")) e.preventDefault();
}
function miniKeyUp(e) { miniKeys[e.key.toLowerCase()] = false; }

function startMiniLoop(mc, mctx) {
  const mg = miniGame;
  const GRAV = 0.5, JUMP = -11, SPEED = 3;
  function miniLoop() {
    if (!miniActive) return;
    miniRaf = requestAnimationFrame(miniLoop);
    const left  = miniKeys["arrowleft"]  || miniKeys["a"];
    const right = miniKeys["arrowright"] || miniKeys["d"];
    const jump  = miniKeys[" "] || miniKeys["arrowup"] || miniKeys["w"];
    mg.pvx = left ? -SPEED : right ? SPEED : 0;
    if (jump && mg.onGround) mg.pvy = JUMP;
    mg.pvy += GRAV;
    mg.px += mg.pvx; mg.py += mg.pvy;
    mg.onGround = false;
    if (mg.pvy >= 0) {
      for (let cx = mg.px; cx <= mg.px + mg.pW; cx += 4) {
        if (miniIsGround(cx, mg.py + mg.pH)) {
          while (miniIsGround(cx, mg.py + mg.pH - 1)) mg.py--;
          mg.pvy = 0; mg.onGround = true; break;
        }
      }
    }
    mg.px = Math.max(0, Math.min(mg.bgW - mg.pW, mg.px));
    if (mg.py < 0) { mg.py = 0; mg.pvy = 0; }
    if (mg.py + mg.pH > mg.bgH) { mg.py = mg.bgH - mg.pH; mg.pvy = 0; mg.onGround = true; }
    // Bad guy patrol — reverse if ground ends ahead or canvas edge reached
    mg.bx += mg.bvx;
    const bCheckX = mg.bvx > 0 ? mg.bx + mg.bW + 2 : mg.bx - 2;
    const groundAhead = miniIsGround(bCheckX, mg.bFloor + 2);
    const atEdge = mg.bx <= 0 || mg.bx + mg.bW >= mg.bgW;
    if (!groundAhead || atEdge) {
      mg.bvx *= -1;
      // Clamp to canvas bounds
      mg.bx = Math.max(0, Math.min(mg.bgW - mg.bW, mg.bx));
    }
    // Bad guy 2 — falls with gravity, no chasing
    if (mg.b2found) {
      mg.b2vy += GRAV;
      mg.b2x += mg.b2vx;
      mg.b2y += mg.b2vy;
      // Ground collision for b2
      mg.b2onGround = false;
      if (mg.b2vy >= 0) {
        for (let cx = mg.b2x; cx <= mg.b2x + mg.b2W; cx += 4) {
          if (miniIsGround(cx, mg.b2y + mg.b2H)) {
            while (miniIsGround(cx, mg.b2y + mg.b2H - 1)) mg.b2y--;
            mg.b2vy = 0; mg.b2onGround = true; break;
          }
        }
      }
      // Canvas edge bounce
      if (mg.b2x <= 0) { mg.b2x = 0; mg.b2vx = Math.abs(mg.b2vx); }
      if (mg.b2x + mg.b2W >= mg.bgW) { mg.b2x = mg.bgW - mg.b2W; mg.b2vx = -Math.abs(mg.b2vx); }
      if (mg.b2y + mg.b2H > mg.bgH) { mg.b2y = mg.bgH - mg.b2H; mg.b2vy = 0; }

      // b2 vs b1 collision — both reverse direction like hitting a wall
      if (mg.b2x < mg.bx+mg.bW && mg.b2x+mg.b2W > mg.bx && mg.b2y < mg.by+mg.bH && mg.b2y+mg.b2H > mg.by) {
        mg.b2vx *= -1; mg.bvx *= -1;
        mg.b2x += mg.b2vx * 2; mg.bx += mg.bvx * 2;
      }

      // Player vs b2
      if (mg.px < mg.b2x+mg.b2W && mg.px+mg.pW > mg.b2x && mg.py < mg.b2y+mg.b2H && mg.py+mg.pH > mg.b2y) { closeMiniGame(false); return; }
    }
    if (mg.px < mg.bx+mg.bW && mg.px+mg.pW > mg.bx && mg.py < mg.by+mg.bH && mg.py+mg.pH > mg.by) { closeMiniGame(false); return; }
    // Collision: player vs goal
    if (mg.px < mg.goalX+mg.goalW && mg.px+mg.pW > mg.goalX && mg.py < mg.goalY+mg.goalH && mg.py+mg.pH > mg.goalY) { closeMiniGame(true); return; }
    // Draw
    mctx.clearRect(0, 0, mg.bgW, mg.bgH);
    mctx.drawImage(mg.bgImg, 0, 0, mg.bgW, mg.bgH);
    if (mg.bgVisualImg) mctx.drawImage(mg.bgVisualImg, 0, 0, mg.bgW, mg.bgH);
    // Bad guy (flip when moving left)
    mctx.save();
    if (mg.bvx < 0) { mctx.translate(mg.bx + mg.bW, mg.by); mctx.scale(-1,1); mctx.drawImage(mg.badImg, 0, 0, mg.bW, mg.bH); }
    else { mctx.drawImage(mg.badImg, mg.bx, mg.by, mg.bW, mg.bH); }
    mctx.restore();
    // Bad guy 2 — flip when going left (sprite faces right naturally)
    if (mg.b2found) {
      mctx.save();
      if (mg.b2vx < 0) {
        mctx.translate(mg.b2x + mg.b2W, mg.b2y);
        mctx.scale(-1, 1);
        mctx.drawImage(mg.bad2Img, 0, 0, mg.b2W, mg.b2H);
      } else {
        mctx.drawImage(mg.bad2Img, mg.b2x, mg.b2y, mg.b2W, mg.b2H);
      }
      mctx.restore();
    }
    // Player
    mctx.drawImage(mg.playerImg, mg.px, mg.py, mg.pW, mg.pH);
  }
  miniRaf = requestAnimationFrame(miniLoop);
}

function closeMiniGame(won) {
  if (!miniActive) return;
  miniActive = false;
  if (miniRaf) { cancelAnimationFrame(miniRaf); miniRaf = null; }
  document.removeEventListener("keydown", miniKeyDown);
  document.removeEventListener("keyup", miniKeyUp);
  document.getElementById("miniGameOverlay").style.display = "none";
  paused = false;
  document.getElementById("bgMusic").play().catch(() => {});
  if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
  loop();
  if (won && miniGameFromAxer && !hasKey) {
    hasKey = true;
    document.getElementById("keySection").style.display = "flex";
    document.getElementById("keySep").style.display = "";
    placeYellowFenceFarAway();
    showToast("🔑 KEY OBTAINED! Axer is impressed.", 3500);
  } else if (won) {
    showToast("🎮 Mini-Game completed!", 3000);
  }
  miniGameFromAxer = false;
}

