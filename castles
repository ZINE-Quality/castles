  setBgMusic("wav/corrupted_castles.wav");
}

// Boss rotation: boss1..boss5 (the dragon) in order, then the Corrupted Heart, then it repeats.
// Shared by the auto boss timer and the "Z" summon key so both stay in the same sequence.
function spawnNextBossOrHeart(bX, bY) {
  const cyclePos = bossSpawnCount % (bossImgs.length + 1);
  bossSpawnCount++;
  if (cyclePos === bossImgs.length) {
    spawnCorruptedHeartAt(bX, bY);
    spawnParticles(bX, bY, "#ff0066", 24, 3);
    showToast("💔 A CORRUPTED HEART HAS APPEARED!");
    return true;
  }
  const bHp = 40 + level * 5;
  bosses.push({ x: bX, y: bY, hp: bHp, maxHp: bHp, timer: 0, facingRight: false, imgIdx: cyclePos });
  spawnParticles(bX, bY, "#ff0000", 25, 3);
  return false;
}

function updateCorruptedHearts() {
  if (peacefulMode) return;

  for (const h of corruptedHearts) {
    h.spawnTimer--;
    const myMinions = corruptedMinions.filter(m => m.heartRef === h);
    if (h.spawnTimer <= 0 && myMinions.length < CORRUPTED_MINION_MAX_PER_HEART) {
      h.spawnTimer = CORRUPTED_MINION_SPAWN_RATE;
      // Always squid, shark, crab, vampire, dragon, in that order, then repeats.
      const type = h.nextMinionType;
      h.nextMinionType = (h.nextMinionType + 1) % CORRUPTED_MINION_STATS.length;
      const cx = h.x + CORRUPTED_HEART_TILE_SPAN / 2, cy = h.y + CORRUPTED_HEART_TILE_SPAN / 2;
      const angle = Math.random() * Math.PI * 2;
      const dist = CORRUPTED_HEART_TILE_SPAN / 2 + 2 + Math.floor(Math.random() * 3);
      const mx = cx + Math.round(Math.cos(angle) * dist);
      const my = cy + Math.round(Math.sin(angle) * dist);
      const stats = CORRUPTED_MINION_STATS[type];
      corruptedMinions.push({ x: mx, y: my, type, dmg: stats.dmg, xp: stats.xp, hp: CORRUPTED_MINION_HITS, maxHp: CORRUPTED_MINION_HITS, timer: 0, heartRef: h });
      h.invertedTiles.add(k(mx, my));
    }
  }

  // Minions move at the dragon boss's speed, and ignore every obstacle that would normally
  // block an enemy — walls, doors, rocks, etc. Every tile they cross gets marked as
  // color-inverted for as long as their heart is alive.
  for (const m of corruptedMinions) {
    m.timer--;
    if (m.timer > 0) continue;
    m.timer = Math.max(8, 20 - level * 2); // same cadence as the dragon boss (imgIdx 4)
    const dx = Math.sign(player.x - m.x), dy = Math.sign(player.y - m.y);
    if (dx !== 0) m.x += dx;
    if (dy !== 0) m.y += dy;
    m.heartRef.invertedTiles.add(k(m.x, m.y));
    if (m.x === player.x && m.y === player.y && player.invincible <= 0) {
      player.hp -= m.dmg;
      player.invincible = 20;
      shakeTimer = 10;
      playOuch();
    }
  }
}

function updateCorruptedProjectiles() {
  // Player shots take 3 hits to kill a corrupted minion
  for (let i = corruptedMinions.length - 1; i >= 0; i--) {
    const m = corruptedMinions[i];
    for (let j = projectiles.length - 1; j >= 0; j--) {
      const p = projectiles[j];
      if (Math.round(p.x) === m.x && Math.round(p.y) === m.y) {
        m.hp--;
        spawnParticles(m.x, m.y, "#ff0066", 6, 2);
        projectiles.splice(j, 1);
        if (m.hp <= 0) {
          spawnTextParticle(m.x, m.y, `+${m.xp}XP`);
          xp += m.xp; score += m.xp * 10;
          corruptedMinions.splice(i, 1);
          checkLevelUp();
        }
        break;
      }
    }
  }
  // Player shots damage the heart itself — hits anywhere on its large planted footprint
  for (const h of corruptedHearts) {
    const cx = h.x + CORRUPTED_HEART_TILE_SPAN / 2, cy = h.y + CORRUPTED_HEART_TILE_SPAN / 2;
    for (let j = projectiles.length - 1; j >= 0; j--) {
      const p = projectiles[j];
      if (p.x >= h.x - 0.5 && p.x <= h.x + CORRUPTED_HEART_TILE_SPAN + 0.5 &&
          p.y >= h.y - 0.5 && p.y <= h.y + CORRUPTED_HEART_TILE_SPAN + 0.5) {
        h.hp -= 5;
        spawnParticles(p.x, p.y, "#ff0066", 5, 1.5);
        spawnTextParticle(cx, cy - 1, "-5", "#ff0066");
        projectiles.splice(j, 1);
        break;
      }
    }
  }
  // Rage kills minions in range and damages the heart if its footprint is in range
  if (rageTimer > 0 && frameCount % 4 === 0) {
    for (let i = corruptedMinions.length - 1; i >= 0; i--) {
      const m = corruptedMinions[i];
      if (Math.abs(m.x - player.x) <= 2 && Math.abs(m.y - player.y) <= 2) {
        spawnParticles(m.x, m.y, "#ff0066", 5, 1.5);
        xp += m.xp; score += m.xp * 10;
        corruptedMinions.splice(i, 1);
        checkLevelUp();
      }
    }
    for (const h of corruptedHearts) {
      const nearestX = Math.max(h.x, Math.min(player.x, h.x + CORRUPTED_HEART_TILE_SPAN));
      const nearestY = Math.max(h.y, Math.min(player.y, h.y + CORRUPTED_HEART_TILE_SPAN));
      if (Math.abs(nearestX - player.x) <= 3 && Math.abs(nearestY - player.y) <= 3) {
        h.hp -= 2;
        spawnParticles(nearestX, nearestY, "#ff0066", 3, 1);
      }
    }
  }
  // Purple storm kills every minion and damages the heart
  if (purpleTimer > 0 && frameCount % 6 === 0) {
    for (let i = corruptedMinions.length - 1; i >= 0; i--) {
      spawnParticles(corruptedMinions[i].x, corruptedMinions[i].y, "#cc44ff", 4, 1.5);
      xp += corruptedMinions[i].xp; score += corruptedMinions[i].xp * 10;
      corruptedMinions.splice(i, 1);
      checkLevelUp();
    }
    for (const h of corruptedHearts) {
      h.hp -= 3;
      spawnParticles(h.x + CORRUPTED_HEART_TILE_SPAN / 2, h.y + CORRUPTED_HEART_TILE_SPAN / 2, "#cc44ff", 4, 1.5);
    }
  }
  for (let i = corruptedHearts.length - 1; i >= 0; i--) {
    const h = corruptedHearts[i];
    if (h.hp <= 0) {
      const cx = h.x + CORRUPTED_HEART_TILE_SPAN / 2, cy = h.y + CORRUPTED_HEART_TILE_SPAN / 2;
      spawnParticles(cx, cy, "#ff0066", 30, 3);
      spawnParticles(cx, cy, "#ffffff", 14, 2);
      spawnTextParticle(cx, cy - 2, "CORRUPTED HEART DESTROYED!", "#ff0066");
      score += 600 + level * 100;
      xp += 20;
      corruptedHearts.splice(i, 1);
      checkLevelUp();
      showToast("💔 CORRUPTED HEART DESTROYED!");
      if (corruptedHearts.length === 0) {
        setBgMusic("wav/castles.wav");
        globalInvertedTiles.clear();
        paused = true;
        document.getElementById("bgMusic").pause();
        document.getElementById("corruptionVictory").style.display = "flex";
      }
    }
  }
}

function updateProjectiles() {
  for (let i = projectiles.length - 1; i >= 0; i--) {
    const p = projectiles[i];
    p.x += p.dx; p.y += p.dy; p.dist++;
    let hit = false;
    for (let j = enemies.length - 1; j >= 0; j--) {
      if (enemies[j].x === Math.round(p.x) && enemies[j].y === Math.round(p.y)) {
        enemies[j].curHp--;
        if (enemies[j].curHp <= 0) {
          spawnParticles(enemies[j].x, enemies[j].y, "#ff8800", 6);
          spawnTextParticle(enemies[j].x, enemies[j].y, `+${enemies[j].xp}XP`);
          xp += enemies[j].xp; score += enemies[j].xp * 10;
          enemies.splice(j, 1);
          checkLevelUp();
        }
        hit = true; break;
      }
    }
    if (!hit) {
      for (let j = bosses.length - 1; j >= 0; j--) {
        if (Math.abs(p.x - bosses[j].x) <= 1 && Math.abs(p.y - bosses[j].y) <= 1) {
          bosses[j].hp -= 5; hit = true;
          spawnParticles(bosses[j].x, bosses[j].y, "#ff4444", 4, 1);
          spawnTextParticle(bosses[j].x, bosses[j].y - 1, "-5", "#ff4444");
          break;
        }
      }
    }
    if (!hit) {
      for (let j = demons.length - 1; j >= 0; j--) {
        if (Math.abs(p.x - demons[j].x) <= 1 && Math.abs(p.y - demons[j].y) <= 1) {
          demons[j].hp -= 5; hit = true;
          spawnParticles(demons[j].x, demons[j].y, "#88ffff", 5, 1.5);
          spawnTextParticle(demons[j].x, demons[j].y - 1, "-5", "#88ffff");
          break;
        }
      }
    }
    if (!hit) {
      for (let j = alienSpawners.length - 1; j >= 0; j--) {
        const s = alienSpawners[j];
        if (!s.defeated && Math.abs(p.x - s.x) <= 1 && Math.abs(p.y - s.y) <= 1) {
          s.hp -= 5; hit = true;
          spawnParticles(s.x, s.y, "#ff4400", 4, 1);
          spawnTextParticle(s.x, s.y - 1, "-5", "#ff4400");
          if (s.hp <= 0) {
            s.hp = 0; s.defeated = true;
            spawnParticles(s.x, s.y, "#aa44ff", 16, 2.5);
            showToast("👽 ALIEN SPAWNER DESTROYED!");
          }
          break;
        }
      }
    }
    if (hit || p.dist > 30) projectiles.splice(i, 1);
  }
}

function checkLevelUp() {
  if (level >= 15) return;
  if (xp >= XP_PER_LEVEL * level) {
    level++;
    player.maxHp = Math.min(player.maxHp + 3, 150);
    player.hp = Math.min(player.hp + 5, player.maxHp);
    if (level === 15) {
      showToast("🏆 MAX LEVEL! HP 150");
    } else {
      showToast(`⬆ LEVEL ${level}! +5 HP`);
    }
  }
}

function showToast(msg, duration = 2000, bigEmoji = false) {
  const t = document.getElementById("levelUpToast");
  if (bigEmoji) {
    // Wrap first and last characters (emojis) in a larger span
    const parts = msg.split(" ");
    const first = parts[0];
    const last = parts[parts.length - 1];
    const middle = parts.slice(1, -1).join(" ");
    t.innerHTML = `<span style="font-size:4em;vertical-align:middle;">${first}</span> ${middle} <span style="font-size:4em;vertical-align:middle;">${last}</span>`;
  } else {
    t.textContent = msg;
  }
  t.style.opacity = "1";
  setTimeout(() => { t.style.opacity = "0"; }, duration);
}

function updateBosses() {
  if (peacefulMode) return;
  if (bossTimer > 0) {
    bossTimer--;
    if (bossTimer === 180) showBossAlert();
  } else {
    const bX = player.x + (Math.random() > 0.5 ? 18 : -18);
    const bY = player.y + (Math.random() > 0.5 ? 18 : -18);
    spawnNextBossOrHeart(bX, bY);
    bossTimer = BOSS_INTERVAL;
  }
  for (let i = bosses.length - 1; i >= 0; i--) {
    const b = bosses[i];
    b.timer--;
    if (b.timer <= 0) {
      b.timer = b.imgIdx === 4 ? Math.max(8, 20 - level * 2) : Math.max(15, 35 - level * 2);
      const dx = Math.sign(player.x - b.x), dy = Math.sign(player.y - b.y);
      if (dx !== 0) b.facingRight = dx > 0;
      let moved = false;
      for (const [bdx, bdy] of [[dx, dy],[dx, 0],[0, dy]]) {
        const nx = b.x + bdx, ny = b.y + bdy;
        const nt = getTile(nx, ny);
        if (nt === "door") continue;
        b.x = nx; b.y = ny; moved = true; break;
      }
      if (getTile(b.x, b.y) === "🍄") {
        b.hp -= 15;
        setTile(b.x, b.y, 0);
        spawnParticles(b.x, b.y, "#aa44ff", 8);
        spawnTextParticle(b.x, b.y - 1, "-15", "#aa44ff");
      }
      if (getTile(b.x, b.y) === "🔥") {
        b.hp -= 8;
        spawnParticles(b.x, b.y, "#ff6600", 6, 2);
        spawnTextParticle(b.x, b.y - 1, "-8", "#ff6600");
      }
      for (let ox = -1; ox <= 1; ox++)
        for (let oy = -1; oy <= 1; oy++) {
          const t = getTile(b.x + ox, b.y + oy);
          if (t !== 0 && t !== "lava" && t !== "🔥" && t !== "yellow_block") setTile(b.x + ox, b.y + oy, 0);
        }
    }
    if (Math.abs(b.x - player.x) <= 1 && Math.abs(b.y - player.y) <= 1 && player.invincible <= 0) {
      player.hp -= 15;
      player.invincible = 40;
      shakeTimer = 20;
      playOuch();
      player.x -= Math.sign(player.x - b.x) * 2;
      player.y -= Math.sign(player.y - b.y) * 2;
    }
    if (b.hp <= 0) {
      spawnParticles(b.x, b.y, "#ffd700", 30, 3);
      spawnTextParticle(b.x, b.y - 2, "BOSS DEFEATED!", "#ffd700");
      score += 500 + level * 100;
      xp += 25;
      bosses.splice(i, 1);
      checkLevelUp();
      showToast("🏆 BOSS SLAIN! +500 SCORE");
      if (b.imgIdx === 4) {
        // Boss 5 defeated — show victory screen
        paused = true;
        document.getElementById("bgMusic").pause();
        document.getElementById("boss5Victory").style.display = "flex";
      }
    }
  }
}

