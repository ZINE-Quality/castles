const k = (x, y) => `${x},${y}`;

function setTile(x, y, v) {
  map[k(x, y)] = v;
  if (v === "🍄") checkMushroomSpawner(x, y);
}
function getTileRaw(x, y) { return map[k(x, y)]; }

function biome(x, y) {
  // Smooth, low-frequency wobble (large wavelength, not per-tile noise) so borders ripple
  // like a natural coastline instead of a perfectly smooth curve — and, critically, instead
  // of fragmenting into salt-and-pepper pixel noise the way per-tile jitter did.
  const wobble = Math.sin(x * 0.05 + y * 0.08) * 0.25 + Math.cos(x * 0.03 - y * 0.06) * 0.25;
  const v = Math.sin(x * 0.01) + Math.cos(y * 0.01) + wobble;
  if (v > 1.25) return "forest";
  if (v > 0.25) {
    // Grasslands never appears near the spawn point — it should be a surprise the player
    // stumbles onto while exploring, not the biome they start in.
    if (Math.hypot(x, y) < 70) return "plains";
    return "grasslands";
  }
  if (v > 0)    return "plains";
  if (v > -0.5) return "pine";
  if (v > -1)   return "mushroom";
  return "desert";
}

function getTile(x, y) {
  const key = k(x, y);
  if (map.hasOwnProperty(key)) return map[key];
  const b = biome(x, y);
  let tile = 0;
  if (Math.random() < 0.002) {
    tile = "lava"; spawnPoints.push({ x, y });
  } else {
    if      (b === "forest"   && Math.random() < 0.08) {
      let ok = true;
      outerT: for (let dy = 0; dy < 4; dy++) {
        for (let dx = 0; dx < 4; dx++) {
          if (dx === 0 && dy === 0) continue;
          const raw = getTileRaw(x + dx, y + dy);
          if (raw !== undefined && raw !== 0) { ok = false; break outerT; }
        }
      }
      if (ok) {
        tile = "🌳";
        for (let dy = 0; dy < 4; dy++)
          for (let dx = 0; dx < 4; dx++)
            if (dx !== 0 || dy !== 0) map[k(x + dx, y + dy)] = "tree_sub";
      }
    }
    else if (b === "pine"     && Math.random() < 0.08) {
      let ok = true;
      outerP: for (let dy = 0; dy < 4; dy++) {
        for (let dx = 0; dx < 4; dx++) {
          if (dx === 0 && dy === 0) continue;
          const raw = getTileRaw(x + dx, y + dy);
          if (raw !== undefined && raw !== 0) { ok = false; break outerP; }
        }
      }
      if (ok) {
        tile = "🌲";
        for (let dy = 0; dy < 4; dy++)
          for (let dx = 0; dx < 4; dx++)
            if (dx !== 0 || dy !== 0) map[k(x + dx, y + dy)] = "barren_sub";
      }
    }
    else if (b === "desert"   && Math.random() < 0.06) {
      let ok = true;
      outerC: for (let dy = 0; dy < 4; dy++) {
        for (let dx = 0; dx < 4; dx++) {
          if (dx === 0 && dy === 0) continue;
          const raw = getTileRaw(x + dx, y + dy);
          if (raw !== undefined && raw !== 0) { ok = false; break outerC; }
        }
      }
      if (ok) {
        tile = "🌵";
        for (let dy = 0; dy < 4; dy++)
          for (let dx = 0; dx < 4; dx++)
            if (dx !== 0 || dy !== 0) map[k(x + dx, y + dy)] = "cactus_sub";
      }
    }
    else if (b === "mushroom" && Math.random() < 0.07) tile = "🍄";
    else if (b === "grasslands") {
      const roll = Math.random();
      if      (roll < 0.02)  tile = "grass_rock";
      else if (roll < 0.035) tile = "flower_yellow";
      else if (roll < 0.05)  tile = "flower_pink";
      else if (roll < 0.065) tile = "flower_blue";
    }
    else if (Math.random() < 0.04) tile = "🪨";
  }
  if (tile === 0) {
    let h = ((x * 374761393 + y * 1120483693) >>> 0);
    h = ((h ^ (h >>> 13)) * 1274126177) >>> 0;
    if (h % 4000 === 0) {
      let ok = true;
      outer: for (let dy = 0; dy < 4; dy++) {
        for (let dx = 0; dx < 4; dx++) {
          if (dx === 0 && dy === 0) continue;
          const raw = getTileRaw(x + dx, y + dy);
          if (raw !== undefined && raw !== 0) { ok = false; break outer; }
        }
      }
      if (ok) {
        tile = "rock_lg";
        for (let dy = 0; dy < 4; dy++)
          for (let dx = 0; dx < 4; dx++)
            if (dx !== 0 || dy !== 0) map[k(x + dx, y + dy)] = "rock_sub";
      }
    }
  }
  map[key] = tile;
  return tile;
}

function spawnParticles(x, y, color, count = 8, speed = 1.5) {
  for (let i = 0; i < count; i++) {
    const angle = Math.random() * Math.PI * 2;
    const v = (Math.random() + 0.5) * speed;
    particles.push({
      x: x * TILE + TILE / 2, y: y * TILE + TILE / 2,
      vx: Math.cos(angle) * v, vy: Math.sin(angle) * v,
      life: 30 + Math.random() * 20, maxLife: 50, color, size: 3 + Math.random() * 3
    });
  }
}
function spawnTextParticle(x, y, text, color = "#ffd700") {
  particles.push({ text, x: x * TILE + TILE / 2, y: y * TILE, vy: -1, life: 50, maxLife: 50, color, isText: true });
}
function updateParticles() {
  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    if (!p.isText) { p.x += p.vx; p.y += p.vy; p.vy += 0.08; }
    else { p.y += p.vy; }
    p.life--;
    if (p.life <= 0) particles.splice(i, 1);
  }
}
function drawParticles() {
  for (const p of particles) {
    const alpha = p.life / p.maxLife;
    ctx.globalAlpha = alpha;
    if (p.isText) {
      ctx.fillStyle = p.color;
      ctx.font = "bold 14px 'Share Tech Mono'";
      ctx.textAlign = "center";
      ctx.fillText(p.text, p.x - camera.x, p.y - camera.y);
    } else {
      ctx.fillStyle = p.color;
      ctx.beginPath();
      ctx.arc(p.x - camera.x, p.y - camera.y, p.size * alpha, 0, Math.PI * 2);
      ctx.fill();
    }
  }
  ctx.globalAlpha = 1;
}

function spawnStructure(type) {
  let sx = Math.floor(Math.random() * 120) - 60;
  let sy = Math.floor(Math.random() * 120) - 60;
  if (Math.abs(sx) < 8 && Math.abs(sy) < 8) return;
  if (type === "room") {
    const size = 5 + Math.floor(Math.random() * 3);
    for (let x = 0; x < size; x++)
      for (let y = 0; y < size; y++)
        if (x === 0 || x === size - 1 || y === 0 || y === size - 1)
          if (!(x === Math.floor(size / 2) && y === 0))
            setTile(sx + x, sy + y, "iron");
  } else if (type === "cross") {
    for (let i = -3; i <= 3; i++) {
      setTile(sx + i, sy, "🪨");
      setTile(sx, sy + i, "🪨");
    }
  }
}

