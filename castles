<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>Castles - Boss Edition</title>
<link rel="icon" type="image/png" href="png/bossfavicon.png">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Share+Tech+Mono&display=swap');
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --green: #88ff88;
    --red: #ff4444;
    --gold: #ffd700;
    --dark: #000;
    --panel: rgba(0,20,0,0.85);
  }
  html, body {
    width: 100%; height: 100%;
    background: #000;
    overflow: hidden;
    font-family: 'Share Tech Mono', monospace;
    color: var(--green);
  }
  canvas { display: block; image-rendering: pixelated; touch-action: none; -webkit-touch-callout: none; }
  #hud {
    position: fixed; top: 0; left: 0; right: 0;
    display: flex; align-items: center; gap: 16px;
    padding: 8px 16px;
    background: var(--panel);
    border-bottom: 1px solid #1a4a1a;
    z-index: 900;
    font-size: 13px;
    backdrop-filter: blur(4px);
  }
  #hud .section { display: flex; align-items: center; gap: 8px; }
  #hud .sep { color: #1a4a1a; font-size: 18px; }
  #hpBar { width: 120px; height: 12px; background: #111; border: 1px solid #333; border-radius: 2px; overflow: hidden; }
  #hpFill { height: 100%; background: linear-gradient(90deg,#ff4444,#ff8800); transition: width 0.2s; border-radius: 2px; }
  #bossTimerVal { color: var(--gold); font-family: 'Press Start 2P', monospace; font-size: 11px; }
  #scoreVal { color: var(--gold); }
  #bestVal { color: #aaffaa; }
  #levelVal { color: #88ffff; }
  .hud-label { color: #448844; font-size: 11px; }
  #controls {
    position: fixed; bottom: 0; left: 0; right: 0;
    background: var(--panel);
    border-top: 1px solid #1a4a1a;
    padding: 5px 12px;
    font-size: 11px; color: #448844;
    z-index: 900;
    display: flex; gap: 12px; flex-wrap: wrap;
    backdrop-filter: blur(4px);
  }
  #controls span { color: var(--green); }
  #titleScreen {
    position: fixed; inset: 0;
    background: #000;
    display: flex; flex-direction: column;
    justify-content: flex-start; align-items: center;
    z-index: 2000; text-align: center;
    gap: 16px;
    overflow-y: auto;
    padding: 40px 0;
    box-sizing: border-box;
  }
  #ascii {
    font-size: 9px; line-height: 13px;
    color: var(--green);
    text-shadow: 0 0 8px #88ff88, 0 0 20px #44aa44;
    letter-spacing: 0;
    animation: flicker 4s infinite;
  }
  @keyframes flicker {
    0%,100%{opacity:1} 92%{opacity:1} 93%{opacity:0.85} 95%{opacity:1} 97%{opacity:0.9}
  }
  #titleText {
    font-family: 'Press Start 2P', monospace;
    font-size: 20px;
    color: var(--gold);
    text-shadow: 0 0 12px var(--gold);
    letter-spacing: 2px;
  }
  #subtitleText { color: #448844; font-size: 13px; max-width: 560px; line-height: 1.6; }
  #startBtn {
    padding: 14px 40px;
    font-family: 'Press Start 2P', monospace;
    font-size: 14px;
    background: #000;
    color: var(--green);
    border: 2px solid var(--green);
    cursor: pointer;
    letter-spacing: 2px;
    box-shadow: 0 0 12px #44aa44;
    transition: all 0.15s;
    animation: pulse 2s infinite;
  }
  @keyframes pulse { 0%,100%{box-shadow:0 0 12px #44aa44} 50%{box-shadow:0 0 24px #88ff88,0 0 40px #44aa44} }
  #startBtn:hover { background: var(--green); color: #000; box-shadow: 0 0 30px #88ff88; }
  #keyHints { color: #336633; font-size: 12px; }
  .overlay {
    position: fixed; inset: 0;
    display: none; flex-direction: column;
    justify-content: center; align-items: center;
    z-index: 3000; text-align: center; gap: 16px;
    backdrop-filter: blur(6px);
  }
  #gameOverScreen { background: rgba(0,0,0,0.92); color: var(--red); }
  #gameOverScreen h1 { font-family: 'Press Start 2P', monospace; font-size: 28px; text-shadow: 0 0 20px var(--red); }
  #gameOverScreen .sub { color: #884444; font-size: 13px; }
  .overlay button {
    padding: 12px 32px;
    font-family: 'Press Start 2P', monospace; font-size: 13px;
    background: #000; cursor: pointer; border: 2px solid;
    letter-spacing: 1px; transition: all 0.15s;
  }
  #gameOverScreen button { color: var(--red); border-color: var(--red); }
  #gameOverScreen button:hover { background: var(--red); color: #000; }
  #levelUpToast {
    position: fixed; top: 60px; left: 50%; transform: translateX(-50%);
    font-family: 'Press Start 2P', monospace; font-size: 14px;
    color: var(--gold); text-shadow: 0 0 12px var(--gold);
    pointer-events: none; z-index: 1000;
    opacity: 0; transition: opacity 0.3s;
  }
  @keyframes shake {
    0%,100%{transform:translate(0,0)} 20%{transform:translate(-4px,3px)} 40%{transform:translate(4px,-3px)}
    60%{transform:translate(-3px,2px)} 80%{transform:translate(3px,-2px)}
  }
  .shaking { animation: shake 0.25s; }
  #bossAlert {
    position: fixed; top: 50%; left: 50%; transform: translate(-50%,-50%);
    font-family: 'Press Start 2P', monospace; font-size: 22px;
    color: var(--red); text-shadow: 0 0 20px var(--red);
    pointer-events: none; z-index: 1500;
    opacity: 0; transition: opacity 0.4s;
    text-align: center;
  }
  @keyframes rainbowText {
    0%  { color: #ff0000; }
    16% { color: #ff8800; }
    33% { color: #ffff00; }
    50% { color: #00ff00; }
    66% { color: #0088ff; }
    83% { color: #8800ff; }
    100%{ color: #ff0000; }
  }
  #touchControls {
    display: none; position: fixed; bottom: 0; left: 0; right: 0;
    pointer-events: none; z-index: 950;
    height: 200px;
  }
  #touchDpad {
    position: absolute; bottom: 20px; left: 20px;
    width: 160px; height: 160px;
    pointer-events: none;
  }
  #touchDpad button {
    position: absolute; pointer-events: auto;
    width: 52px; height: 52px;
    background: rgba(136,255,136,0.18);
    border: 2px solid rgba(136,255,136,0.4);
    border-radius: 8px;
    color: rgba(136,255,136,0.7);
    font-family: 'Press Start 2P', monospace;
    font-size: 16px;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    cursor: pointer;
    transition: background 0.08s;
  }
  #touchDpad button:active, #touchDpad button.pressed {
    background: rgba(136,255,136,0.4);
    border-color: rgba(136,255,136,0.7);
  }
  #touchDpad .dpad-up    { top: 0;   left: 54px; }
  #touchDpad .dpad-left  { top: 54px; left: 0; }
  #touchDpad .dpad-down  { top: 108px; left: 54px; }
  #touchDpad .dpad-right { top: 54px; left: 108px; }
  #touchActions {
    position: absolute; right: 16px; top: 50%; transform: translateY(-50%);
    display: flex; flex-direction: column;
    gap: 10px;
    pointer-events: none;
  }
  #touchActions button {
    pointer-events: auto;
    width: 68px; height: 68px;
    background: rgba(136,255,136,0.18);
    border: 2px solid rgba(136,255,136,0.4);
    border-radius: 10px;
    color: rgba(136,255,136,0.8);
    font-family: 'Press Start 2P', monospace;
    font-size: 9px;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    cursor: pointer;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 4px;
    transition: background 0.08s;
  }
  #touchActions button:active, #touchActions button.pressed {
    background: rgba(136,255,136,0.4);
    border-color: rgba(136,255,136,0.7);
  }
  #touchActions .btn-icon { font-size: 18px; line-height: 1; }
  body.ios-tablet #touchDpad { width: 280px; height: 280px; bottom: 30px; left: 30px; }
  body.ios-tablet #touchDpad button { width: 88px; height: 88px; font-size: 24px; }
  body.ios-tablet #touchDpad .dpad-up    { top: 0;   left: 92px; }
  body.ios-tablet #touchDpad .dpad-left  { top: 92px; left: 0; }
  body.ios-tablet #touchDpad .dpad-down  { top: 184px; left: 92px; }
  body.ios-tablet #touchDpad .dpad-right { top: 92px; left: 184px; }
  body.ios-tablet #touchActions { gap: 16px; right: 24px; }
  body.ios-tablet #touchActions button { width: 110px; height: 80px; font-size: 13px; }
  body.ios-tablet #touchActions .btn-icon { font-size: 28px; }
</style>
</head>
