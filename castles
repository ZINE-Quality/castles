// ─── GRASSLANDS BIOME ──────────────────────────────────────────
const grassImg = new Image(); grassImg.src = 'png/grass.png';
const grassStompImg = new Image(); grassStompImg.src = 'png/grass_stomp.png';
const grassEdgeImg = new Image(); grassEdgeImg.src = 'png/grass_edge.png';
let stompedGrassTiles = new Map(); // tile key -> frameCount it was last stomped at
const GRASS_REGROW_DURATION = 64 * 60; // 64 seconds for grass_stomp.png to fully regrow into grass.png

// Pixel data for the stomp->grass dissolve, captured once both textures finish loading
let grassPixelData = null; // { w, h, stompData, grassData, noise }
function tryInitGrassRegrowData() {
  if (grassPixelData) return;
  if (!(grassImg.complete && grassImg.naturalWidth > 0 && grassStompImg.complete && grassStompImg.naturalWidth > 0)) return;
  const w = grassStompImg.naturalWidth, h = grassStompImg.naturalHeight;
  const tmp = document.createElement('canvas');
  tmp.width = w; tmp.height = h;
  const tctx = tmp.getContext('2d');
  tctx.drawImage(grassStompImg, 0, 0, w, h);
  const stompData = tctx.getImageData(0, 0, w, h).data;
  tctx.clearRect(0, 0, w, h);
  tctx.drawImage(grassImg, 0, 0, w, h);
  const grassData = tctx.getImageData(0, 0, w, h).data;
  const noise = new Float32Array(w * h);
  for (let i = 0; i < noise.length; i++) noise[i] = Math.random();
  grassPixelData = { w, h, stompData, grassData, noise };
}

// Cache of blended regrow canvases, one per currently-regrowing tile. Recomputed at most
// once per ~1s-worth of progress (64 discrete steps over GRASS_REGROW_DURATION) instead of
// every frame, since a per-pixel blend is far too costly to redo 60 times a second.
const regrowBlendCache = new Map(); // tile key -> { step, canvas }
const GRASS_REGROW_STEPS = 64;
function getRegrowingTileCanvas(key, progress) {
  if (!grassPixelData) return null;
  const step = Math.min(GRASS_REGROW_STEPS - 1, Math.floor(progress * GRASS_REGROW_STEPS));
  const cached = regrowBlendCache.get(key);
  if (cached && cached.step === step) return cached.canvas;
  const { w, h, stompData, grassData, noise } = grassPixelData;
  const threshold = step / (GRASS_REGROW_STEPS - 1);
  const out = new Uint8ClampedArray(stompData.length);
  for (let p = 0, px = 0; p < noise.length; p++, px += 4) {
    const src = noise[p] <= threshold ? grassData : stompData;
    out[px] = src[px]; out[px + 1] = src[px + 1]; out[px + 2] = src[px + 2]; out[px + 3] = src[px + 3];
  }
  const canvas = cached ? cached.canvas : document.createElement('canvas');
  canvas.width = w; canvas.height = h;
  canvas.getContext('2d').putImageData(new ImageData(out, w, h), 0, 0);
  const entry = { step, canvas };
  regrowBlendCache.set(key, entry);
  return canvas;
}

const grassEdgeCache = {}; // memoized per-tile edge-detection result (biome() itself isn't cached)
function isGrassEdgeTile(x, y) {
  const key = k(x, y);
  if (grassEdgeCache.hasOwnProperty(key)) return grassEdgeCache[key];
  // A single-tile outline hugging the coastline — true only if an immediate neighbor
  // (the surrounding ring of 8 tiles) isn't grasslands.
  let isEdge = false;
  for (let dy = -1; dy <= 1 && !isEdge; dy++) {
    for (let dx = -1; dx <= 1; dx++) {
      if (dx === 0 && dy === 0) continue;
      if (biome(x + dx, y + dy) !== "grasslands") { isEdge = true; break; }
    }
  }
  grassEdgeCache[key] = isEdge;
  return isEdge;
}
const FLOWER_TYPES = ["yellow", "pink", "blue"];
const flowerGifSrcs = { yellow: 'gif/yellow_flower.gif', pink: 'gif/pink_flower.gif', blue: 'gif/blue_flower.gif' };
const flowerStaticSrcs = {}; // frozen first-frame snapshot of each gif, shown when the player is far away
FLOWER_TYPES.forEach(type => {
  const img = new Image();
  img.onload = () => {
    try {
      const c = document.createElement('canvas');
      c.width = img.naturalWidth; c.height = img.naturalHeight;
      c.getContext('2d').drawImage(img, 0, 0);
      flowerStaticSrcs[type] = c.toDataURL();
    } catch (e) { /* canvas capture unavailable — the gif will just always animate */ }
  };
  img.src = flowerGifSrcs[type];
});
// Real <img> pool so the flower GIFs can actually animate (canvas drawImage freezes GIFs on frame 1)
const flowerGifPool = Array.from({length: 60}, () => {
  const el = document.createElement('img');
  el.style.cssText = 'display:none;position:fixed;pointer-events:none;z-index:3;image-rendering:pixelated;';
  document.body.appendChild(el);
  return el;
});

// ─── FENCED COMPOUND (grasslands-only structure) ────────────────
const axerImg = new Image(); axerImg.src = 'png/axer.png';
const houseImg = new Image(); houseImg.src = 'png/house.png';
const FENCE_COMPOUND_SIZE = 16; // full 16x16 footprint, iron perimeter + one door tile
const HOUSE_SIZE = 8; // 8x8 footprint, placed against the wall opposite the door
let fenceCompounds = []; // holds at most one: { x, y, size, house: {x,y,size}, axer: {...}, wanderBounds }
let showAxerArrow = false; // toggled by the N key — points at the axer from anywhere on the map
let hasKey = false; // earned by beating the mini-game after Axer's challenge
let axerDialogCooldown = 0; // frames of grace after the dialog closes before it can trigger again
let miniGameFromAxer = false; // was the currently-open mini-game launched via Axer's challenge?

function showAxerDialog() {
  paused = true;
  document.getElementById("bgMusic").pause();
  document.getElementById("axerDialog").style.display = "flex";
}

function closeAxerDialog(accepted) {
  document.getElementById("axerDialog").style.display = "none";
  axerDialogCooldown = 120;
  if (accepted) {
    miniGameFromAxer = true;
    openMiniGame();
    return;
  }
  paused = false;
  document.getElementById("bgMusic").play().catch(() => {});
  if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
  loop();
}

function canPlaceFenceCompoundAt(ax, ay) {
  for (let dy = 0; dy < FENCE_COMPOUND_SIZE; dy++) {
    for (let dx = 0; dx < FENCE_COMPOUND_SIZE; dx++) {
      const tx = ax + dx, ty = ay + dy;
      if (getTileRaw(tx, ty) !== undefined) return false;
      if (biome(tx, ty) !== "grasslands") return false;
    }
  }
  return true;
}

function spawnFenceCompoundAt(ax, ay) {
  const size = FENCE_COMPOUND_SIZE;
  const perimeterTiles = [];
  for (let i = 1; i < size - 1; i++) {
    perimeterTiles.push({x: ax + i, y: ay});
    perimeterTiles.push({x: ax + i, y: ay + size - 1});
    perimeterTiles.push({x: ax, y: ay + i});
    perimeterTiles.push({x: ax + size - 1, y: ay + i});
  }
  const doorTile = perimeterTiles[Math.floor(Math.random() * perimeterTiles.length)];
  for (let dy = 0; dy < size; dy++) {
    for (let dx = 0; dx < size; dx++) {
      const tx = ax + dx, ty = ay + dy;
      const onBorder = dx === 0 || dy === 0 || dx === size - 1 || dy === size - 1;
      if (onBorder) {
        map[k(tx, ty)] = (tx === doorTile.x && ty === doorTile.y) ? "door" : "iron";
      } else {
        // Pre-claim the interior so getTile() never rolls a flower/rock decoration here
        map[k(tx, ty)] = 0;
      }
    }
  }

  // Interior bounds (inclusive)
  const ix0 = ax + 1, ix1 = ax + size - 2;
  const iy0 = ay + 1, iy1 = ay + size - 2;
  const hs = HOUSE_SIZE;

  // House goes against the wall opposite the door, centered on the other axis
  let hx, hy;
  const wanderBounds = { minX: ix0, maxX: ix1, minY: iy0, maxY: iy1 };
  if (doorTile.y === ay) { // door on top wall -> house against bottom
    hx = ix0 + Math.floor((ix1 - ix0 + 1 - hs) / 2);
    hy = iy1 - hs + 1;
    wanderBounds.maxY = hy - 1;
  } else if (doorTile.y === ay + size - 1) { // door on bottom -> house against top
    hx = ix0 + Math.floor((ix1 - ix0 + 1 - hs) / 2);
    hy = iy0;
    wanderBounds.minY = hy + hs;
  } else if (doorTile.x === ax) { // door on left -> house against right
    hy = iy0 + Math.floor((iy1 - iy0 + 1 - hs) / 2);
    hx = ix1 - hs + 1;
    wanderBounds.maxX = hx - 1;
  } else { // door on right -> house against left
    hy = iy0 + Math.floor((iy1 - iy0 + 1 - hs) / 2);
    hx = ix0;
    wanderBounds.minX = hx + hs;
  }

  // Stamp the house footprint — blocks movement like a rock (see "house"/"house_sub" checks)
  for (let dy = 0; dy < hs; dy++) {
    for (let dx = 0; dx < hs; dx++) {
      map[k(hx + dx, hy + dy)] = (dx === 0 && dy === 0) ? "house" : "house_sub";
    }
  }

  // Inset the wander area so the axer's (larger than one tile) sprite can't visually
  // overhang into the fence or the house — keep at least a 2-tile-wide strip either way.
  const AXER_VISUAL_MARGIN = 1;
  if (wanderBounds.maxX - wanderBounds.minX > AXER_VISUAL_MARGIN * 2) {
    wanderBounds.minX += AXER_VISUAL_MARGIN; wanderBounds.maxX -= AXER_VISUAL_MARGIN;
  }
  if (wanderBounds.maxY - wanderBounds.minY > AXER_VISUAL_MARGIN * 2) {
    wanderBounds.minY += AXER_VISUAL_MARGIN; wanderBounds.maxY -= AXER_VISUAL_MARGIN;
  }

  const cx = Math.round((wanderBounds.minX + wanderBounds.maxX) / 2);
  const cy = Math.round((wanderBounds.minY + wanderBounds.maxY) / 2);
  fenceCompounds.push({
    x: ax, y: ay, size,
    house: { x: hx, y: hy, size: hs },
    wanderBounds,
    axer: { x: cx, y: cy, timer: 30 }
  });
}

// Places the single fenced compound once, at game start, in the nearest patch of grasslands
// to spawn — spirals outward ring by ring from the origin until a clear 16x16 spot is found.
function placeFenceCompoundNearSpawn() {
  if (fenceCompounds.length > 0) return;
  const half = Math.floor(FENCE_COMPOUND_SIZE / 2);
  for (let radius = 0; radius <= 400; radius += 4) {
    const steps = Math.max(8, radius);
    for (let i = 0; i < steps; i++) {
      const angle = (i / steps) * Math.PI * 2;
      const cx = Math.round(Math.cos(angle) * radius);
      const cy = Math.round(Math.sin(angle) * radius);
      const ax = cx - half, ay = cy - half;
      if (canPlaceFenceCompoundAt(ax, ay)) {
        spawnFenceCompoundAt(ax, ay);
        return;
      }
    }
  }
}

// ─── YELLOW KEY FENCE (far away, only passable once the key is earned) ─────
const castleImg = new Image(); castleImg.src = 'png/castle.png';
const YELLOW_FENCE_SIZE = 16;
const CASTLE_SIZE = 12; // bulk of the 14x14 interior, leaving a 1-tile walkway all around
let keyFence = null; // { x, y, size } — x,y is the top-left anchor, null until the key is earned

function canPlaceYellowFenceAt(ax, ay) {
  for (let dy = 0; dy < YELLOW_FENCE_SIZE; dy++) {
    for (let dx = 0; dx < YELLOW_FENCE_SIZE; dx++) {
      if (getTileRaw(ax + dx, ay + dy) !== undefined) return false;
    }
  }
  return true;
}

function spawnYellowFenceAt(ax, ay) {
  const size = YELLOW_FENCE_SIZE;
  for (let dy = 0; dy < size; dy++) {
    for (let dx = 0; dx < size; dx++) {
      const onBorder = dx === 0 || dy === 0 || dx === size - 1 || dy === size - 1;
      if (onBorder) map[k(ax + dx, ay + dy)] = "yellow_block";
    }
  }

  // Castle takes up the bulk of the interior, centered — solid, blocks movement like a rock
  const ix0 = ax + 1, ix1 = ax + size - 2;
  const iy0 = ay + 1, iy1 = ay + size - 2;
  const cs = CASTLE_SIZE;
  const castleX = ix0 + Math.floor((ix1 - ix0 + 1 - cs) / 2);
  const castleY = iy0 + Math.floor((iy1 - iy0 + 1 - cs) / 2);
  for (let dy = 0; dy < cs; dy++) {
    for (let dx = 0; dx < cs; dx++) {
      map[k(castleX + dx, castleY + dy)] = (dx === 0 && dy === 0) ? "castle" : "castle_sub";
    }
  }

  keyFence = { x: ax, y: ay, size, castle: { x: castleX, y: castleY, size: cs } };
}

// Placed the moment the key is earned, far out on the map — practically guaranteed to be
// unclaimed ground out there, so no need for the closest-spot search the axer compound uses.
function placeYellowFenceFarAway() {
  if (keyFence) return;
  const half = Math.floor(YELLOW_FENCE_SIZE / 2);
  const distance = 800 + Math.floor(Math.random() * 400);
  const angle = Math.random() * Math.PI * 2;
  let ax = Math.round(Math.cos(angle) * distance) - half;
  let ay = Math.round(Math.sin(angle) * distance) - half;
  let tries = 0;
  while (!canPlaceYellowFenceAt(ax, ay) && tries < 20) { ax += YELLOW_FENCE_SIZE; tries++; }
  spawnYellowFenceAt(ax, ay);
}

function updateFenceCompounds() {
  if (axerDialogCooldown > 0) axerDialogCooldown--;
  for (const fc of fenceCompounds) {
    const a = fc.axer;
    if (!hasKey && axerDialogCooldown <= 0 && a.x === player.x && a.y === player.y) {
      showAxerDialog();
      return;
    }
    a.timer--;
    if (a.timer <= 0) {
      a.timer = 40 + Math.floor(Math.random() * 40);
      const wb = fc.wanderBounds;
      a.x = Math.min(wb.maxX, Math.max(wb.minX, a.x + Math.floor(Math.random() * 3) - 1));
      a.y = Math.min(wb.maxY, Math.max(wb.minY, a.y + Math.floor(Math.random() * 3) - 1));
    }
  }
}

